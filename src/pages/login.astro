---
import CardPage from '../layouts/CardPage.astro';
import { isAuthConfigured, authenticate, startSession, getSessionUser } from '../lib/auth.js';

if (getSessionUser(Astro.cookies)) return Astro.redirect('/');

let error = '';
if (!isAuthConfigured()) {
  Astro.response.status = 503;
  error = 'El acceso todavía no está configurado en el servidor.';
} else if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const user = await authenticate(form.get('user'), form.get('password'));
  if (user) {
    startSession(Astro.cookies, user);
    return Astro.redirect('/');
  }
  Astro.response.status = 401;
  error = 'Usuario o contraseña incorrectos.';
}
---
<CardPage title="Ingresar">
  <h2>Ingresar</h2>
  <p class="muted">Acceso privado al comparador.</p>
  <form method="post" action="/login">
    <label>Usuario<input name="user" autocomplete="username" required autofocus /></label>
    <label>Contraseña<input name="password" type="password" autocomplete="current-password" required /></label>
    {error && <p class="form-message error" role="alert">{error}</p>}
    <div class="actions"><button type="submit">Entrar</button></div>
  </form>
</CardPage>
