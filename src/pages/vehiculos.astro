---
import AppPage from "../layouts/AppPage.astro";
import MonthlyDialog from "../components/MonthlyDialog.astro";
---
<AppPage title="Vehículos" current="vehiculos">
<main><section><div class="section-head"><div><h2>Vehículos</h2><p class="muted">Precios, documentos, ofertas de crédito y seguros de cada vehículo.</p></div><button type="button" id="add">+ Agregar vehículo</button></div><div id="cards" class="grid"></div><div id="empty" class="empty"><div class="empty-icon" aria-hidden="true">⚡</div><h2>Empieza tu comparación</h2><p>Agrega tu primer vehículo y reúne aquí sus precios, fotos y costos.</p><button type="button" id="add-first">+ Agregar mi primer vehículo</button></div></section></main><dialog id="modal"><form id="form" novalidate><div class="modal-header"><div class="step-header"><div><small class="accent" id="step-count"></small><h2 id="wizard-title">Agregar vehículo</h2></div><button type="button" class="secondary" id="cancel" aria-label="Cerrar">✕</button></div><nav class="steps" aria-label="Pasos del vehículo"><button type="button" data-step="0"><i data-lucide="car-front" aria-hidden="true"></i><span>Vehículo</span></button><button type="button" data-step="1"><i data-lucide="file-text" aria-hidden="true"></i><span>Documentos</span></button><button type="button" data-step="2"><i data-lucide="landmark" aria-hidden="true"></i><span>Financiación</span></button><button type="button" data-step="3"><i data-lucide="shield-check" aria-hidden="true"></i><span>Seguros</span></button></nav></div><input type="hidden" name="id"/><div class="modal-content" id="modalContent">
<div class="step"><h3 class="step-title">Tu vehículo</h3><p class="muted">Agrega lo esencial y elige la foto que aparecerá en el listado.</p><div class="grid"><label>Nombre y versión<input name="name" required placeholder="Ej. GWM Ora 5 Full"/></label><label>Precio (COP)<input name="price" class="money" type="text" inputmode="numeric" value="0"/></label></div><div class="media-section"><h3 class="step-title">Fotos y videos</h3><p class="muted">Arrastra tus archivos o selecciónalos para subirlos. Se optimizan al terminar la carga.</p><div id="uploader" class="dropzone" tabindex="0" role="button" aria-label="Seleccionar fotos y videos"><div class="dz-message"><span class="upload-icon" aria-hidden="true">↑</span><strong class="pointer-fine">Arrastra fotos y videos aquí</strong><span class="pointer-fine">o haz clic en cualquier parte para elegir archivos</span><strong class="pointer-coarse">Toca para elegir fotos y videos</strong></div></div><div id="upload-previews" class="dropzone-previews"></div><p id="status" role="status" class="muted"></p><div id="saved-section" hidden><h3>Archivos guardados</h3><div id="files" class="gallery"></div></div></div></div>
<div class="step" hidden><h3 class="step-title">Costo de documentos</h3><p class="muted">Selecciona una tarifa de referencia o introduce una cotización.</p><div class="grid"><label class="document-select">Matrícula · Barranquilla<select name="registrationOption" id="registrationOption"><option value="none">Sin definir</option><option value="electric">Eléctrico o híbrido particular · $ 356.798</option><option value="electricLien">Eléctrico o híbrido con gravamen · $ 434.009</option><option value="standard">Particular · $ 398.798</option><option value="standardLien">Particular con gravamen · $ 518.009</option><option value="custom">Otro valor / cotización</option></select><span class="selected-option" id="registrationChoice" aria-live="polite"></span></label><label>Valor de matrícula (COP)<input name="registration" class="money" type="text" inputmode="numeric" value="0"/></label><label>Beneficio o descuento adicional<input name="benefitName" placeholder="Ej. descuento del concesionario"/></label><label>Porcentaje de descuento adicional (%)<input name="benefitPercent" type="number" min="0" max="100" step="0.01" value="0"/></label><label class="document-select">SOAT · categoría de referencia<select name="soatOption" id="soatOption"><option value="none">Sin definir</option><option value="511">Auto familiar, menor a 1.500 cc, 0–9 años · $ 447.300</option><option value="512">Auto familiar, menor a 1.500 cc, 10 años o más · $ 592.900</option><option value="211">Campero o camioneta, menor a 1.500 cc, 0–9 años · $ 792.800</option><option value="212">Campero o camioneta, menor a 1.500 cc, 10 años o más · $ 953.000</option><option value="custom">Otra tarifa / cotización</option></select><span class="selected-option" id="soatChoice" aria-live="polite"></span></label><label>SOAT anual antes del beneficio (COP)<input name="soat" class="money" type="text" inputmode="numeric" value="0"/></label><label>Beneficio sobre el SOAT (%)<input name="soatDiscount" id="soatDiscount" type="number" min="0" max="100" step="0.01" value="0"/></label><div class="document-select"><p class="muted" id="soatTotal" aria-live="polite"></p><small>El porcentaje se aplica al total ingresado como una estimación. Confirma con la aseguradora si tu beneficio aplica al total o solo a una parte.</small></div><label class="document-select">Impuesto vehicular · Atlántico<select name="taxMode" id="taxMode"><option value="electric">Estimar para vehículo 100 % eléctrico</option><option value="manual">Ingresar liquidación oficial</option></select></label><div class="document-select tax-estimate" id="taxEstimate" hidden><div class="grid"><label>Avalúo comercial (COP)<input name="appraisal" class="money" type="text" inputmode="numeric" value="0"/></label><label>Tarifa sobre avalúo (%)<input name="taxRate" id="taxRate" type="number" min="0" max="1" step="0.01" value="1"/></label><label>Descuento departamental<select name="taxDiscount" id="taxDiscount"><option value="0">Sin descuento</option><option value="70">70 % · nuevo elegible, 5 vigencias siguientes</option></select></label></div><small>El avalúo se inicia con el precio solo como referencia; sustitúyelo por el avalúo fiscal oficial, que puede ser diferente. El 70 % corresponde a los cinco años siguientes al de matrícula para vehículos nuevos elegibles; no se aplica automáticamente al año de matrícula. Confirma la liquidación con la Gobernación. <a href="https://atlantico.gov.co/images/stories/gacetas/2024/DECRETO_ORDENANZAL_487_DE_2024_PARTE_1.pdf" target="_blank" rel="noopener">Ver norma departamental</a>.</small></div><label>Impuesto vehicular anual estimado (COP)<input name="tax" class="money" type="text" inputmode="numeric" value="0"/></label><label class="document-select">Derecho de tránsito anual · Barranquilla<select name="transitOption" id="transitOption"><option value="none">Sin definir</option><option value="electric">Eléctrico / híbrido · $ 149.500</option><option value="standard">Particular convencional · $ 299.000</option><option value="custom">Otro valor / liquidación</option></select></label><label>Valor de tránsito anual (COP)<input name="transit" class="money" type="text" inputmode="numeric" value="0"/></label><label>Beneficio en derecho de tránsito<select name="transitDiscount" id="transitDiscount"><option value="0">Sin descuento</option><option value="10">10 % por pronto pago 2026 (si es elegible)</option></select></label><div class="document-select"><small>El 10 % por pronto pago de 2026 estuvo sujeto a fecha y requisitos; no se aplica automáticamente. <a href="https://barranquilla.gov.co/transito/vehiculos-con-placa-de-barranquilla-10-de-descuento-en-derecho-de-transito-2026-hasta-el-31-de-mayo" target="_blank" rel="noopener">Condiciones y plazo 2026</a>.</small><p class="muted" id="transitTotal"></p></div></div><div class="registration-breakdown" id="registrationBreakdown" hidden></div><p class="muted" id="registrationTotal"></p><small>Tarifas oficiales de Barranquilla 2026, incluidos los valores especiales para eléctricos e híbridos. Aplica el descuento adicional solo si corresponde a la matrícula. <a href="https://barranquilla.gov.co/wp-content/uploads/2026/01/tarifas-2026-v7-ort-1.pdf" target="_blank" rel="noopener">Ver tarifas oficiales</a>. Los beneficios del derecho de tránsito anual son independientes de la matrícula.</small><p><small>SOAT: valores máximos 2026 con aportes y RUNT. Para eléctricos se usa el menor cilindraje de la categoría correspondiente; verifica la clase en la tarjeta de propiedad y la cotización. <a href="https://www.fasecolda.com/wp-content/uploads/Tarifas-SOAT-2026-referencia.pdf" target="_blank" rel="noopener">Tabla de Fasecolda</a>.</small></p></div>
<div class="step" hidden><h3 class="step-title">Ofertas de financiación</h3><p class="muted">Las ofertas se comparten entre todos tus vehículos: agrégalas una sola vez y elige cuál usar en este. Si editas o eliminas una, el cambio aplica a todos.</p><div id="finance-offers"></div><div id="finance-empty" class="finance-empty"><strong>Compara tus opciones</strong><p>Agrega la primera oferta para calcular su cuota y compararla con otras.</p></div><button type="button" class="secondary" id="addFinance">+ Agregar primera oferta</button></div>
<div class="step" hidden><h3 class="step-title">Seguros</h3><p class="muted">Agrega los seguros y activa los que quieras incluir en el cálculo.</p><div id="insurances"></div><button type="button" class="secondary" id="addInsurance">+ Agregar primer seguro</button></div>
</div><div class="wizard-actions"><button type="button" class="secondary" id="back" aria-label="Atrás">←<span class="wide-label"> Atrás</span></button><div><button type="submit" id="save">Crear vehículo</button><button type="button" id="next" class="secondary"><span class="wide-label">Documentos </span>→</button></div></div></form></dialog><MonthlyDialog />
</AppPage>
<script>
import { $, fmt, esc, financeOffers, setFinanceOffers, selectedOffer, activeInsurances, calc, showMonthlyBreakdown, vehicleMediaHtml, fetchJson } from "../scripts/comparador.js";

import Dropzone from "dropzone";
import AutoNumeric from "autonumeric";
import { animate } from "motion";
import "dropzone/dist/dropzone.css";
let vehicles=[],media=[],savedMedia=[],step=0,uploading=false,primaryImage='';
const moneyOptions={digitGroupSeparator:'.',decimalCharacter:',',decimalPlaces:0,minimumValue:'0',maximumValue:'999999999999999',modifyValueOnWheel:false};
const moneyFields={};document.querySelectorAll('input.money').forEach(el=>moneyFields[el.name]=new AutoNumeric(el,moneyOptions));
function updateSelectedOptions(){for(const [selectId,textId] of [['registrationOption','registrationChoice'],['soatOption','soatChoice']]){const el=document.getElementById(selectId);document.getElementById(textId).textContent=el.value==='none'?'':el.selectedOptions[0].textContent}}
function updateSoat(){const amount=Number(moneyFields.soat.getNumber())||0;const discount=Math.min(100,Math.max(0,Number($('#soatDiscount').value)||0));$('#soatTotal').textContent='SOAT anual después del beneficio: '+fmt(amount*(1-discount/100))}
$('#soatDiscount').oninput=updateSoat;
const soatOptions={none:0,'511':447300,'512':592900,'211':792800,'212':953000};$('#soatOption').onchange=e=>{if(e.target.value!=='custom')moneyFields.soat.set(soatOptions[e.target.value]);updateSelectedOptions();syncTariffControls();updateSoat()};document.querySelector('[name=soat]').addEventListener('input',()=>{$('#soatOption').value='custom';updateSelectedOptions();updateSoat()});
const registrationOptions={none:0,electric:356798,electricLien:434009,standard:398798,standardLien:518009};
const transitOptions={none:0,electric:149500,standard:299000};
function syncTariffControls(){for(const [option,field] of [['registrationOption','registration'],['soatOption','soat'],['transitOption','transit']])document.querySelector(`[name=${field}]`).readOnly=$('#'+option).value!=='custom'}
function updateTax(){const estimate=$('#taxMode').value==='electric';$('#taxEstimate').hidden=!estimate;document.querySelector('[name=tax]').readOnly=estimate;if(estimate){const appraisal=Number(moneyFields.appraisal.getNumber())||0;const rate=Math.min(1,Math.max(0,Number($('#taxRate').value)||0));const discount=Math.min(100,Math.max(0,Number($('#taxDiscount').value)||0));moneyFields.tax.set(Math.round(appraisal*rate/100*(1-discount/100)))}}
function updateTransit(){const value=Number(moneyFields.transit.getNumber())||0, discount=Math.min(100,Math.max(0,Number($('#transitDiscount').value)||0));$('#transitTotal').textContent='Derecho de tránsito estimado: '+fmt(value*(1-discount/100))}
$('#taxMode').onchange=updateTax;$('#taxRate').oninput=updateTax;$('#taxDiscount').onchange=updateTax;document.querySelector('[name=appraisal]').addEventListener('input',updateTax);
$('#transitOption').onchange=e=>{if(e.target.value!=='custom')moneyFields.transit.set(transitOptions[e.target.value]);updateTransit();syncTariffControls()};document.querySelector('[name=transit]').addEventListener('input',()=>{$('#transitOption').value='custom';updateTransit()});$('#transitDiscount').onchange=updateTransit;
const registrationBreakdowns={electric:[213000,3200,50598,72000,18000],electricLien:[255000,4300,75909,72000,26800],standard:[213000,45200,50598,72000,18000],standardLien:[255000,88300,75909,72000,26800]};
function updateRegistration(){const breakdown=registrationBreakdowns[$('#registrationOption').value];const box=$('#registrationBreakdown');box.hidden=!breakdown;if(breakdown){const labels=['Derechos, placa y sistematización','Estampillas distritales','Estampillas departamentales','Ministerio de Transporte','RUNT'];box.innerHTML='<strong>Desglose de matrícula · tarifa oficial 2026</strong>'+breakdown.map((value,i)=>`<div><span>${labels[i]}</span><span>${fmt(value)}</span></div>`).join('')+'<small>Solo incluye este trámite. SOAT, impuesto vehicular, derecho de tránsito y otros cobros se calculan aparte.</small>'}const val=Number(moneyFields.registration.getNumber())||0;const disc=Math.min(100,Math.max(0,Number(document.querySelector('[name=benefitPercent]').value)||0));$('#registrationTotal').textContent='Matrícula estimada después del descuento: '+fmt(val*(1-disc/100));}
$('#registrationOption').onchange=e=>{if(e.target.value!=='custom')moneyFields.registration.set(registrationOptions[e.target.value]);updateRegistration();updateSelectedOptions();syncTariffControls()};document.querySelector('[name=registration]').addEventListener('input',()=>{document.querySelector('[name=registrationOption]').value='custom';updateRegistration();updateSelectedOptions()});document.querySelector('[name=benefitPercent]').addEventListener('input',updateRegistration);
const dropzone=new Dropzone('#uploader',{url:'/api/upload',paramName:'file',clickable:true,previewsContainer:'#upload-previews',acceptedFiles:'image/*,video/*',maxFilesize:Infinity,parallelUploads:1,timeout:0,addRemoveLinks:false,dictRemoveFile:'Quitar',dictCancelUpload:'Cancelar carga',dictCancelUploadConfirmation:'¿Cancelar la carga?',dictInvalidFileType:'Solo se admiten imágenes y videos.',dictFileTooBig:'El archivo es demasiado grande.',dictResponseError:'No se pudo subir el archivo ({{statusCode}}).',previewTemplate:`<div class="upload-card"><div class="upload-thumb"><img data-dz-thumbnail alt=""><span class="upload-file-icon" aria-hidden="true">▶</span></div><div class="upload-detail"><strong class="upload-name" data-dz-name></strong><span class="upload-size" data-dz-size></span><span class="upload-state">En espera</span><button class="primary-choice" type="button" data-primary hidden>Elegir como principal</button><div class="upload-progress"><span data-dz-uploadprogress></span></div><span class="upload-error" data-dz-errormessage></span></div><button class="upload-remove" type="button" data-dz-remove aria-label="Quitar archivo">✕</button></div>`});
let resetting=false;
function refreshUploadState(){uploading=dropzone.getUploadingFiles().length>0||dropzone.getQueuedFiles().length>0;$('#save').disabled=uploading;}
dropzone.on('addedfile',()=>{refreshUploadState();$('#status').textContent='Preparando archivos…'});
dropzone.on('processing',file=>{file.previewElement.querySelector('.upload-state').textContent='Subiendo…';refreshUploadState();$('#status').textContent='Subiendo archivos…'});
dropzone.on('uploadprogress',(file,progress)=>{if(progress>=100){file.previewElement.querySelector('.upload-state').textContent='Optimizando…';$('#status').textContent='Carga completa. Optimizando el archivo; esto puede tardar…'}});
dropzone.on('success',(file,response)=>{file.savedMedia=response;media.push(response);if(response.type==='image'){const choice=file.previewElement.querySelector('[data-primary]');choice.hidden=false;choice.onclick=()=>{primaryImage=response.url;updatePrimary()};if(!primaryImage)primaryImage=response.url}updatePrimary();file.previewElement.querySelector('.upload-state').textContent='Listo';$('#status').textContent='Archivo procesado y listo.'});
dropzone.on('error',(file,message)=>{file.previewElement.querySelector('.upload-state').textContent='Error';$('#status').textContent=typeof message==='string'?message:'No se pudo subir el archivo.';refreshUploadState()});
dropzone.on('removedfile',file=>{if(!resetting&&file.savedMedia){media=media.filter(m=>m.url!==file.savedMedia.url);if(primaryImage===file.savedMedia.url)primaryImage=media.find(m=>m.type==='image')?.url||'';showFiles();updatePrimary()}refreshUploadState()});
dropzone.on('queuecomplete',()=>{refreshUploadState()});
$('#uploader').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();$('#uploader').click()}});

function setStep(n){step=n;$('#modalContent').scrollTop=0;document.querySelectorAll('.step').forEach((el,i)=>el.hidden=i!==n);document.querySelectorAll('.steps [data-step]').forEach((el,i)=>{el.classList.toggle('current',i===n);el.classList.toggle('completed',i<n);if(i===n)el.setAttribute('aria-current','step');else el.removeAttribute('aria-current')});$('#step-count').textContent=`PASO ${n+1} DE 4`;$('#back').hidden=n===0;$('#next').hidden=n===3;const nextName=['Documentos','Financiación','Seguros',''][n];$('#next').querySelector('.wide-label').textContent=nextName+' ';$('#next').setAttribute('aria-label','Siguiente: '+nextName);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)animate(document.querySelectorAll('.step')[n],{opacity:[0,1],transform:['translateY(10px)','translateY(0px)']},{duration:.25});}
document.querySelectorAll('.steps [data-step]').forEach(btn=>btn.addEventListener('click',()=>setStep(Number(btn.dataset.step))));
$('#back').onclick=()=>setStep(step-1);$('#next').onclick=()=>{const current=document.querySelectorAll('.step')[step];for(const input of current.querySelectorAll('input'))if(!input.reportValidity())return;if(step===0 && !Number(moneyFields.appraisal.getNumber()) && $('#taxMode').value==='electric'){moneyFields.appraisal.set(moneyFields.price.getNumber());updateTax()}setStep(step+1)};
function updatePrimary(){dropzone.files.forEach(file=>{if(file.savedMedia?.type==='image'){let btn=file.previewElement.querySelector('[data-primary]');btn.textContent=primaryImage===file.savedMedia.url?'★ Foto principal':'☆ Elegir como principal';btn.classList.toggle('selected',primaryImage===file.savedMedia.url)}});document.querySelectorAll('[data-saved-primary]').forEach(btn=>{const active=btn.dataset.savedPrimary===primaryImage;btn.textContent=active?'★ Foto principal':'☆ Hacer principal';btn.classList.toggle('selected',active)})}
function updateInsuranceAction(){$('#addInsurance').textContent=$('#insurances').children.length?'+ Agregar otro seguro':'+ Agregar primer seguro'}
function insurance(x={}){let d=document.createElement('div');d.className='insurance';d.dataset.id=x.id||crypto.randomUUID();d.innerHTML=`<label><input type="checkbox" class="active" ${x.active?'checked':''}> Incluir seguro</label><div class="grid"><label>Nombre<input class="iname" value="${esc(x.name||'')}"></label><label>Descripción<input class="desc" value="${esc(x.description||'')}"></label><label>Precio mensual<input class="cost" type="text" inputmode="numeric" value="${Number(x.cost)||0}"></label></div><button class="danger remove" type="button">Eliminar seguro</button>`;d.querySelector('.remove').onclick=()=>{d.remove();updateInsuranceAction()};$('#insurances').append(d);updateInsuranceAction();new AutoNumeric(d.querySelector('.cost'),moneyOptions)}
function showFiles(){ $('#saved-section').hidden=!savedMedia.length; $('#files').innerHTML=savedMedia.map((m,i)=>`<div>${m.type==='video'?`<video src="${esc(m.url)}" controls></video>`:`<img src="${esc(m.url)}" alt="Foto">`}${m.type==='image'?`<button type="button" class="primary-choice" data-saved-primary="${esc(m.url)}">☆ Hacer principal</button>`:''}<button type="button" class="danger" data-remove="${i}">Quitar</button></div>`).join('');$('#files').querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{const removed=savedMedia.splice(+b.dataset.remove,1)[0];media=media.filter(m=>m.url!==removed.url);if(primaryImage===removed.url)primaryImage=media.find(m=>m.type==='image')?.url||'';showFiles();updatePrimary()});$('#files').querySelectorAll('[data-saved-primary]').forEach(b=>b.onclick=()=>{primaryImage=b.dataset.savedPrimary;updatePrimary()});updatePrimary() }
function updateFinanceSelection(){document.querySelectorAll('.finance-offer').forEach(offer=>{const active=offer.querySelector('input[type=radio]').checked;offer.classList.toggle('finance-selected',active);offer.querySelector('.finance-radio-label').textContent=active?'Usada en este vehículo':'Usar en este vehículo'})}
function updateFinanceAction(){updateFinanceSelection();const any=$('#finance-offers').children.length>0;$('#finance-empty').hidden=any;$('#addFinance').textContent=any?'+ Agregar otra oferta':'+ Agregar primera oferta'}
function financeTermOptions(value){const term=Number(value)||60;const terms=[12,24,36,48,60,72];if(term>0&&!terms.includes(term))terms.push(term);return terms.sort((a,b)=>a-b).map(months=>{const years=Math.floor(months/12),remaining=months%12;const label=[years?`${years} ${years===1?'año':'años'}`:'',remaining?`${remaining} ${remaining===1?'mes':'meses'}`:''].filter(Boolean).join(' y ');return `<option value="${months}" ${months===term?'selected':''}>${months} meses (${label})${months%12?' · plazo guardado':''}</option>`}).join('')}
function addFinance(x={},selected=false){const id=x.id||crypto.randomUUID();const d=document.createElement('div');d.className='finance-offer';d.dataset.id=id;d.innerHTML=`<div class="finance-head"><label class="finance-radio"><input type="radio" name="financeChoice" value="${esc(id)}" ${selected?'checked':''}><span class="finance-radio-button"><span class="finance-radio-icon" aria-hidden="true">✓</span><span class="finance-radio-label">Elegir para el resumen</span></span></label><button type="button" class="danger finance-remove">Eliminar</button></div><div class="grid"><label>Banco u oferta<input class="finance-name" required placeholder="Ej. Banco A" value="${esc(x.name||'')}"></label><label>Porcentaje financiado (%)<input class="finance-percent" type="number" required min="0" max="100" step="0.01" value="${Number(x.percent)||0}"></label><label>Tasa efectiva mensual (%)<input class="finance-rate" type="number" required min="0" step="0.01" value="${Number(x.rate)||0}"></label><label>Plazo<select class="finance-months" required>${financeTermOptions(x.months)}</select></label></div><p class="finance-preview"></p>`;d.querySelector('.finance-remove').onclick=()=>{const was=d.querySelector('input[type=radio]').checked;d.remove();if(was){const first=$('#finance-offers input[type=radio]');if(first)first.checked=true}updateFinanceAction()};d.addEventListener('input',()=>{updateFinancePreview(d);updateFinanceSelection()});$('#finance-offers').append(d);if(!$('#finance-offers input[type=radio]:checked'))d.querySelector('input[type=radio]').checked=true;updateFinancePreview(d);updateFinanceAction()}
function updateFinancePreview(d){const p=(moneyFields.price.getNumber()||0)*(Number(d.querySelector('.finance-percent').value)||0)/100,r=(Number(d.querySelector('.finance-rate').value)||0)/100,n=Number(d.querySelector('.finance-months').value)||1,q=r?p*r/(1-Math.pow(1+r,-n)):p/n;d.querySelector('.finance-preview').textContent=`Monto financiado: ${fmt(p)} · Cuota estimada: ${fmt(q)} / mes`}
function openForm(v={}){let f=$('#form');for(const input of f.querySelectorAll('input:not(.money)')){if(input.type==='checkbox')input.checked=input.defaultChecked;else input.value=input.type==='hidden'?'':input.defaultValue}for(const select of f.querySelectorAll('select'))select.selectedIndex=0;for(let k of ['id','name','benefitName','benefitPercent','registrationOption','soatOption','soatDiscount','taxMode','taxRate','taxDiscount','transitOption','transitDiscount'])if(v[k]!=null)f.elements[k].value=v[k];for(const key of ['price','registration','soat','tax','appraisal','transit'])moneyFields[key].set(v[key]??0);$('#soatOption').value=v.soatOption||((+v.soat||0)>0?'custom':'none');$('#registrationOption').value=v.registrationOption||((+v.registration||0)>0?'custom':'none');$('#transitOption').value=v.transitOption||((+v.transit||0)>0?'custom':'none');if(!v.id)$('#taxMode').value='electric';syncTariffControls();updateRegistration();updateSelectedOptions();updateTax();updateTransit();updateSoat();$('#save').textContent=v.id?'Guardar cambios':'Crear vehículo';$('#wizard-title').textContent=v.id?'Editar vehículo':'Agregar vehículo';$('#finance-offers').innerHTML='';const chosenOffer=selectedOffer(v);financeOffers.forEach(offer=>addFinance(offer,offer.id===chosenOffer?.id));updateFinanceAction();$('#insurances').innerHTML='';(v.insurances||[]).forEach(insurance);updateInsuranceAction();media=[...(v.media||[])];savedMedia=[...media];primaryImage=v.primaryImage||media.find(m=>m.type==='image')?.url||'';showFiles();$('#status').textContent='';resetting=true;dropzone.removeAllFiles(true);resetting=false;refreshUploadState();setStep(0);$('#modal').showModal()}
function render(){
  $('#empty').hidden=!!vehicles.length;
  $('#cards').innerHTML=vehicles.map(v=>{
    const c=calc(v);
    const offers=financeOffers;const image=vehicleMediaHtml(v);
    return `<article class="vehicle-card"><div class="vehicle-top"><div class="vehicle-visual">${image}</div><div class="vehicle-overview"><div><span class="eyebrow">VEHÍCULO</span><h2>${esc(v.name)}</h2><span class="vehicle-price-label">Precio del vehículo</span><div class="vehicle-price">${fmt(v.price)}</div></div><div class="vehicle-monthly"><span>Costo mensual estimado</span><button type="button" class="monthly-link overview-link" data-monthly-vehicle="${v.id}" data-monthly-offer="${esc(c.chosen.id||'')}"><strong>${fmt(c.monthly)}<small> / mes</small></strong><span>Ver desglose ↗</span></button></div></div></div><div class="vehicle-summary"><div><span>Pago inicial + matrícula</span><strong>${fmt(c.initial)}</strong></div><div><span>Mensualidades y gastos · ${c.n} meses</span><strong>${fmt(Math.round(c.total)-Math.round(c.initial))}</strong></div><div class="summary-total"><span>Total estimado al final</span><strong>${fmt(c.total)}</strong></div></div>${offers.length?`<div class="finance-comparison"><div class="finance-comparison-head"><h3>Ofertas de financiación</h3><small>Selecciona una oferta para actualizar el resumen</small></div><div class="finance-list">${offers.map(o=>{const oc=calc(v,o),active=o.id===c.chosen.id;return `<button type="button" class="finance-option ${active?'selected':''}" data-finance-vehicle="${v.id}" data-finance-id="${esc(o.id)}" aria-pressed="${active}"><span><strong>${esc(o.name)}</strong><small>${o.percent}% financiado · ${o.rate}% mensual · ${o.months} meses</small></span><span><strong>${fmt(oc.monthly)} / mes</strong><small>Inicial ${fmt(oc.initial)} · Total ${fmt(oc.total)}</small></span></button>`}).join('')}</div></div>`:''}<section class="insurance-comparison" aria-label="Seguros de ${esc(v.name)}"><div class="insurance-comparison-head"><div><h3>Seguros</h3><small>Activa los seguros que quieres incluir en la comparación.</small></div><strong>${fmt(c.ins)} <small>/ mes</small></strong></div>${(v.insurances||[]).length?`<div class="insurance-options">${v.insurances.map((insurance,index)=>`<button type="button" class="insurance-option ${insurance.active?'selected':''}" data-insurance-vehicle="${v.id}" data-insurance-index="${index}" aria-pressed="${!!insurance.active}"><span class="insurance-indicator" aria-hidden="true">${insurance.active?'✓':'+'}</span><span class="insurance-info"><strong>${esc(insurance.name||'Seguro sin nombre')}</strong>${insurance.description?`<small>${esc(insurance.description)}</small>`:''}<span class="insurance-state">${insurance.active?'Incluido en el cálculo':'Añadir al cálculo'}</span></span><strong class="insurance-cost">${fmt(+insurance.cost||0)} <small>/ mes</small></strong></button>`).join('')}</div>`:`<div class="insurance-empty"><span>Agrega una opción para comparar su costo.</span><button type="button" class="secondary" data-add-insurance="${v.id}">+ Agregar primer seguro</button></div>`}</section><details class="vehicle-details"><summary>Ver desglose de costos <span aria-hidden="true">⌄</span></summary><div class="breakdown"><div class="row"><span>Financiado (${+c.chosen.percent||0} %)</span><strong>${fmt(c.p)}</strong></div><div class="row"><span>Cuota mensual</span><strong>${fmt(c.q)}</strong></div><div class="row"><span>Seguros mensuales</span><strong>${fmt(c.ins)}</strong></div><div class="row"><span>SOAT / mes</span><strong>${fmt(c.soat/12)}</strong></div><div class="row"><span>Impuesto vehicular / mes</span><strong>${fmt((+v.tax||0)/12)}</strong></div><div class="row"><span>Derecho de tránsito / mes</span><strong>${fmt(c.transit/12)}</strong></div></div><p class="vehicle-note">Costos anuales prorrateados; el acumulado supone que las tarifas y descuentos ingresados se mantienen durante todo el plazo.</p></details><div class="vehicle-actions"><button class="secondary" data-edit="${v.id}">Editar y ver fotos</button><button class="danger" data-delete="${v.id}">Eliminar</button></div></article>`;
  }).join('');
  document.querySelectorAll('[data-monthly-vehicle]').forEach(button=>button.onclick=()=>{const v=vehicles.find(item=>item.id==button.dataset.monthlyVehicle);const offer=financeOffers.find(item=>item.id===button.dataset.monthlyOffer);showMonthlyBreakdown(v,offer)});
  document.querySelectorAll('[data-finance-vehicle]').forEach(b=>b.onclick=async()=>{const v=vehicles.find(x=>x.id==b.dataset.financeVehicle);v.selectedFinanceId=b.dataset.financeId;const r=await fetch('/api/vehicles',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(v)});if(r.ok)render();else alert('No se pudo guardar la selección')});
  document.querySelectorAll('[data-insurance-vehicle]').forEach(button=>button.onclick=async()=>{const v=vehicles.find(item=>item.id==button.dataset.insuranceVehicle);const index=Number(button.dataset.insuranceIndex);const updated={...v,insurances:v.insurances.map((item,i)=>i===index?{...item,active:!item.active}:item)};const controls=button.closest('.insurance-options').querySelectorAll('button');controls.forEach(el=>el.disabled=true);try{const response=await fetch('/api/vehicles',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(updated)});if(!response.ok)throw new Error();Object.assign(v,updated);render()}catch{controls.forEach(el=>el.disabled=false);alert('No se pudo actualizar el seguro. Inténtalo de nuevo.')}});
  document.querySelectorAll('[data-add-insurance]').forEach(button=>button.onclick=()=>{const v=vehicles.find(item=>item.id==button.dataset.addInsurance);openForm(v);setStep(3)});
  document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openForm(vehicles.find(v=>v.id==b.dataset.edit)));
  document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(confirm('¿Eliminar este vehículo?')){await fetch('/api/vehicles',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:+b.dataset.delete})});load()}})
}
async function load(){const [vehicleList,offerList]=await Promise.all([fetchJson('/api/vehicles'),fetchJson('/api/finance-offers')]);vehicles=vehicleList;setFinanceOffers(offerList);render()}$('#add').onclick=()=>openForm();$('#add-first').onclick=()=>openForm();$('#cancel').onclick=()=>{if(uploading){$('#status').textContent='Espera a que termine la carga o cancélala desde el gestor.';return}$('#modal').close()};$('#modal').addEventListener('cancel',e=>{if(uploading){e.preventDefault();$('#status').textContent='Espera a que termine la carga o cancélala desde el gestor.'}});$('#addInsurance').onclick=()=>insurance();$('#addFinance').onclick=()=>addFinance();$('#form').onsubmit=async e=>{e.preventDefault();if(uploading)return;const pending=dropzone.files.some(file=>file.status!=='success');if(pending){$('#status').textContent='Sube o elimina los archivos pendientes antes de guardar.';return}let f=e.target;const invalidOffer=[...document.querySelectorAll('#finance-offers input:not([type=radio]), #finance-offers select')].find(x=>!x.checkValidity());if(invalidOffer){setStep(2);invalidOffer.reportValidity();return}for(const input of f.querySelectorAll('.step input, .step select')){if(!input.checkValidity()){const panel=input.closest('.step');setStep([...document.querySelectorAll('.step')].indexOf(panel));input.reportValidity();return}}let d=Object.fromEntries(new FormData(f));for(const key of ['price','registration','soat','tax','appraisal','transit'])d[key]=moneyFields[key].getNumericString()||'0';const offers=[...document.querySelectorAll('.finance-offer')].map(x=>({id:x.dataset.id,name:x.querySelector('.finance-name').value.trim(),percent:Number(x.querySelector('.finance-percent').value),rate:Number(x.querySelector('.finance-rate').value),months:Number(x.querySelector('.finance-months').value)}));d.selectedFinanceId=document.querySelector('#finance-offers input[type=radio]:checked')?.value||'';d.primaryImage=primaryImage;d.id=Number(d.id)||undefined;d.media=media;d.insurances=[...document.querySelectorAll('.insurance')].map(x=>({id:x.dataset.id,active:x.querySelector('.active').checked,name:x.querySelector('.iname').value,description:x.querySelector('.desc').value,cost:+AutoNumeric.getAutoNumericElement(x.querySelector('.cost')).getNumericString()}));const savedOffers=await fetch('/api/finance-offers',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(offers)});if(!savedOffers.ok)return alert(await savedOffers.text());let r=await fetch('/api/vehicles',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});if(!r.ok)return alert(await r.text());$('#modal').close();load()};load();

</script>
