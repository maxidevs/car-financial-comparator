---
import AppPage from "../layouts/AppPage.astro";
import MonthlyDialog from "../components/MonthlyDialog.astro";
---
<AppPage title="Comparativas" current="comparativas">
<main><p class="accent">TU PRÓXIMO ELÉCTRICO, EN NÚMEROS</p><h1>Compara con <span class="accent">claridad.</span></h1><p class="muted">Precio, financiación y costos asociados en un solo lugar.</p><section id="electionsSection"><div class="section-head"><div><h2>Comparativas guardadas</h2><p class="muted">Cada elección combina un vehículo, un crédito y una póliza. Los valores se recalculan con los datos actuales.</p></div><button type="button" id="addElection">+ Nueva elección</button></div><div id="elections"></div><div id="noVehicles" class="empty" hidden><div class="empty-icon" aria-hidden="true">⚡</div><h2>Primero agrega tus vehículos</h2><p>Para armar una elección necesitas al menos un vehículo con su precio y sus pólizas.</p><a href="/vehiculos" class="button">Ir a vehículos</a></div><div id="electionsEmpty" class="empty"><div class="empty-icon" aria-hidden="true">⚖</div><h2>Aún no guardas elecciones</h2><p>Combina un vehículo, un crédito y una póliza para tener su total y su desglose siempre a mano.</p></div></section></main><MonthlyDialog /><dialog id="electionDialog" class="panel-dialog" aria-labelledby="electionTitle"><div class="monthly-dialog-head"><div><small class="accent">NUEVA ELECCIÓN</small><h2 id="electionTitle">Arma tu elección</h2><p class="muted">Elige un vehículo, un crédito y una póliza de ese vehículo.</p></div><button class="secondary" id="electionClose" type="button" aria-label="Cerrar">✕</button></div><div class="monthly-content"><label>Vehículo<select id="electionVehicle"></select></label><label>Crédito<select id="electionOffer"></select></label><label>Póliza del vehículo<select id="electionInsurance"></select></label><label>Nombre (opcional)<input id="electionName" maxlength="120" placeholder="Ej. Geely con Davivienda"/></label><div id="electionPreview"></div><p class="form-message error" id="electionError" role="alert" hidden></p></div><div class="monthly-dialog-footer"><button type="button" id="electionSave">Guardar elección</button></div></dialog>
</AppPage>
<script>
import { $, fmt, esc, financeOffers, setFinanceOffers, selectedOffer, NO_FINANCING, activeInsurances, calc, showMonthlyBreakdown, vehicleMediaHtml, summaryHtml, fetchJson } from "../scripts/comparador.js";
let vehicles=[],elections=[];
// Resuelve una elección contra los datos actuales: los números siempre se recalculan.
function resolveElection(e){const v=vehicles.find(x=>x.id===e.vehicleId);const offer=e.offerId?financeOffers.find(x=>x.id===e.offerId):NO_FINANCING;const insurance=e.insuranceId?v?.insurances?.find(x=>x.id===e.insuranceId):null;const missing=[!v&&'el vehículo',!offer&&'la oferta de crédito',v&&e.insuranceId&&!insurance&&'la póliza'].filter(Boolean);return{v,offer,insurance,insurances:insurance?[insurance]:[],missing,label:[v?.name,offer?.name,insurance?.name||(e.insuranceId?'Póliza eliminada':'Sin póliza')].filter(Boolean).join(' · ')}}
function renderElections(){
  $('#addElection').hidden=!vehicles.length;$('#noVehicles').hidden=!!vehicles.length;$('#electionsEmpty').hidden=!vehicles.length||!!elections.length;
  $('#elections').innerHTML=elections.map(e=>{const r=resolveElection(e),ok=!r.missing.length,c=ok&&calc(r.v,r.offer,r.insurances);
    return `<article class="vehicle-card election-card"><div class="vehicle-top"><div class="vehicle-visual">${r.v?vehicleMediaHtml(r.v):'<div class="vehicle-media vehicle-placeholder"><span aria-hidden="true">◇</span><small>Vehículo eliminado</small></div>'}</div><div class="vehicle-overview"><div><span class="eyebrow">ELECCIÓN</span><h2>${esc(e.name||r.label)}</h2>${e.name?`<small class="muted">${esc(r.label)}</small>`:''}</div>${ok?`<div class="vehicle-monthly"><span>Costo mensual estimado</span><button type="button" class="monthly-link overview-link" data-election-breakdown="${e.id}"><strong>${fmt(c.monthly)}<small> / mes</small></strong><span>Ver desglose ↗</span></button></div>`:''}</div></div>${ok?summaryHtml(c):`<p class="form-message error">Ya no existe ${r.missing.join(' ni ')}. Elimina esta elección y crea otra.</p>`}<div class="vehicle-actions"><button class="danger" data-election-delete="${e.id}">Eliminar</button></div></article>`}).join('');
  document.querySelectorAll('[data-election-breakdown]').forEach(b=>b.onclick=()=>{const r=resolveElection(elections.find(e=>e.id==b.dataset.electionBreakdown));showMonthlyBreakdown(r.v,r.offer,r.insurances)});
  document.querySelectorAll('[data-election-delete]').forEach(b=>b.onclick=async()=>{if(!confirm('¿Eliminar esta elección?'))return;await fetch('/api/elections',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:+b.dataset.electionDelete})});load()});
}
function electionDraft(){return{vehicleId:Number($('#electionVehicle').value),offerId:$('#electionOffer').value,insuranceId:$('#electionInsurance').value,name:$('#electionName').value.trim()}}
function fillElectionInsurances(){const v=vehicles.find(x=>x.id===Number($('#electionVehicle').value));const list=v?.insurances||[];$('#electionInsurance').innerHTML=list.length?list.map(i=>`<option value="${esc(i.id)}">${esc(i.name||'Seguro sin nombre')} · ${fmt(+i.cost||0)} / mes</option>`).join(''):'<option value="">Sin póliza (este vehículo no tiene)</option>';const preferred=activeInsurances(v||{})[0];if(preferred)$('#electionInsurance').value=preferred.id}
function updateElectionPreview(){const r=resolveElection(electionDraft());if(r.missing.length){$('#electionPreview').innerHTML='';return}const c=calc(r.v,r.offer,r.insurances);$('#electionPreview').innerHTML=`<div class="monthly-total"><span>Costo mensual estimado</span><strong>${fmt(c.monthly)}</strong></div><div class="monthly-row"><span>Pago inicial + matrícula</span><strong>${fmt(c.initial)}</strong></div><div class="monthly-row"><span>Total estimado al final · ${c.n} meses</span><strong>${fmt(c.total)}</strong></div>`}
function openElectionForm(){$('#electionVehicle').innerHTML=vehicles.map(v=>`<option value="${v.id}">${esc(v.name)}</option>`).join('');$('#electionOffer').innerHTML=financeOffers.map(o=>`<option value="${esc(o.id)}">${esc(o.name)} · ${o.percent}% · ${o.rate}% mensual · ${o.months} meses</option>`).join('')+'<option value="">De contado (sin crédito)</option>';const v=vehicles[0];$('#electionOffer').value=selectedOffer(v)?.id||'';fillElectionInsurances();$('#electionName').value='';$('#electionError').hidden=true;updateElectionPreview();$('#electionDialog').showModal()}
$('#addElection').onclick=openElectionForm;$('#electionClose').onclick=()=>$('#electionDialog').close();
$('#electionVehicle').onchange=()=>{const v=vehicles.find(x=>x.id===Number($('#electionVehicle').value));$('#electionOffer').value=selectedOffer(v)?.id||'';fillElectionInsurances();updateElectionPreview()};
$('#electionOffer').onchange=updateElectionPreview;$('#electionInsurance').onchange=updateElectionPreview;
$('#electionSave').onclick=async()=>{const r=await fetch('/api/elections',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(electionDraft())});if(!r.ok){$('#electionError').textContent=await r.text();$('#electionError').hidden=false;return}$('#electionDialog').close();load()};
async function load(){const [vehicleList,offerList,electionList]=await Promise.all([fetchJson('/api/vehicles'),fetchJson('/api/finance-offers'),fetchJson('/api/elections')]);vehicles=vehicleList;setFinanceOffers(offerList);elections=electionList;renderElections()}
load();
</script>
