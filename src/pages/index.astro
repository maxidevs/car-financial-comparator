import "../styles/base.css";
---
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Volt · Comparador eléctrico</title><style is:global>

.step[hidden]{display:none}.step-header{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:18px}.steps{display:flex;gap:6px;margin:18px 0 28px}.step-title{font-size:1.45rem;margin-bottom:6px}.wizard-actions{display:flex;justify-content:space-between;gap:10px;margin-top:24px}.wizard-actions div{display:flex;gap:8px}button:disabled{opacity:.45;cursor:not-allowed}.gallery>div{display:flex;flex-direction:column;gap:4px}.gallery img,.gallery video{width:140px;height:100px;object-fit:cover;border-radius:8px}.gallery{padding:10px 0}button,.button{transition:transform .18s,filter .18s}button:hover:not(:disabled),.button:hover{filter:brightness(1.1);transform:translateY(-2px)}button:focus-visible,.button:focus-visible,input:focus-visible{outline:3px solid #6af8cb;outline-offset:2px}#uploader.dropzone{min-height:220px;border:2px dashed #3f7a80;border-radius:16px;background:#10232b;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:border-color .2s,background .2s}#uploader.dropzone:hover,#uploader.dz-drag-hover{border-color:#6af8cb;background:#16353a}#uploader .dz-message{display:flex;flex-direction:column;align-items:center;gap:10px;margin:0;color:#a9bdc4;pointer-events:none}#uploader .dz-message strong{font-size:1.1rem;color:#e8f6fa}#uploader .upload-icon{font-size:2rem;color:#6af8cb;border:1px solid #3f7a80;border-radius:12px;width:52px;height:52px;display:grid;place-items:center}#upload-previews{display:flex;flex-wrap:wrap;gap:12px;margin-top:16px}#upload-previews .dz-preview{background:#192a32;border-radius:12px;color:#e8f6fa;margin:0;padding:12px;min-height:160px;width:150px}#upload-previews .dz-image{border-radius:8px}#upload-previews .dz-details{color:#fff}#upload-previews .dz-remove{color:#8ef5d2;margin-top:8px}#upload-previews .dz-error-message{top:135px;left:0}#upload-previews .dz-progress{background:#334b50}#upload-previews .dz-upload{background:#6af8cb}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}

#upload-previews{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px;margin:14px 0}.upload-card{display:flex;align-items:center;gap:12px;min-width:0;padding:10px;border:1px solid #2e4850;background:#14262e;border-radius:12px}.upload-thumb{width:64px;height:64px;flex:none;border-radius:8px;overflow:hidden;background:#223a41;display:grid;place-items:center;position:relative}.upload-thumb img{position:absolute;width:100%;height:100%;object-fit:cover;opacity:0}.upload-card.dz-image-preview .upload-thumb img{opacity:1}.upload-file-icon{color:#6af8cb}.upload-detail{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px;font-size:12px;color:#a9bdc4}.upload-name{font-size:13px;color:#e8f6fa;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.upload-state{color:#6af8cb}.upload-progress{height:4px;background:#29424a;border-radius:5px;overflow:hidden}.upload-progress span{display:block;width:0;height:100%;background:#6af8cb;transition:width .2s}.upload-card.dz-success .upload-progress{display:none}.upload-error{display:none;color:#ffabb4;overflow-wrap:anywhere}.upload-card.dz-error .upload-error{display:block}.upload-card.dz-error .upload-state{color:#ffabb4}.upload-remove{flex:none;width:32px;height:32px;padding:0;background:#223b43;color:#d5eeee}.gallery{display:flex;gap:12px;flex-wrap:wrap;overflow:visible}.gallery>div{width:140px;height:auto;flex:none}.gallery img,.gallery video{display:block;width:140px;height:100px;object-fit:cover}.gallery button{padding:8px}.upload-card.dz-image-preview .upload-file-icon{display:none}

select{width:100%;margin-top:6px;padding:11px;border:1px solid #35505b;border-radius:8px;background:#09141a;color:white;font:inherit}select:focus-visible{outline:3px solid #6af8cb;outline-offset:2px}.media-section{margin-top:28px}.primary-choice{padding:4px 0;background:none;color:#9ab9bc;font-size:11px;text-align:left}.primary-choice.selected{color:#6af8cb}.upload-detail .primary-choice{white-space:nowrap}.gallery .primary-choice{font-size:12px;text-align:center}.gallery>div{height:auto}.wizard-actions{flex-wrap:wrap}.wizard-actions>div{flex-wrap:wrap}a{color:#6af8cb}

.document-select{grid-column:1 / -1;min-width:0}.document-select select{max-width:100%}.selected-option{display:block;margin-top:7px;color:#b8d4d3;font-size:.8rem;line-height:1.4;overflow-wrap:anywhere}.selected-option:empty{display:none}@media(min-width:640px){.selected-option{display:none}}
input[readonly]{opacity:.8;background:#12232b}.tax-estimate[hidden]{display:none}.tax-estimate{padding:14px;border:1px solid #29454d;border-radius:12px}.tax-estimate small{display:block;line-height:1.5;margin-top:10px}

#cards{display:grid;grid-template-columns:minmax(0,1fr);gap:18px}.vehicle-card{min-width:0;border:1px solid #29434d;border-radius:18px;background:#101d25;padding:20px;color:#e8f6fa}.vehicle-top{display:grid;grid-template-columns:minmax(200px,320px) minmax(0,1fr);gap:26px;align-items:stretch}.vehicle-visual{min-width:0}.vehicle-media{display:block;width:100%;aspect-ratio:16/9;height:auto;max-height:220px;object-fit:cover;border-radius:12px;background:#1a3038}.vehicle-placeholder{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;color:#82a4a8}.vehicle-placeholder span{font-size:28px}.vehicle-overview{display:flex;align-items:center;justify-content:space-between;gap:24px;min-width:0}.eyebrow{font-size:.68rem;letter-spacing:.11em;font-weight:700;color:#6af8cb}.vehicle-overview h2{font-size:clamp(1.2rem,2vw,1.65rem);line-height:1.25;overflow-wrap:anywhere;margin:6px 0 18px}.vehicle-price-label,.vehicle-summary span,.vehicle-monthly>span{display:block;color:#a1b5bc;font-size:.8rem}.vehicle-price{font-size:clamp(1.5rem,2.2vw,2rem);font-weight:750;letter-spacing:-.03em}.vehicle-monthly{border-left:1px solid #2b424b;padding-left:26px;flex-shrink:0}.vehicle-monthly strong{display:block;font-size:clamp(1.4rem,2.2vw,1.85rem);color:#6af8cb;margin-top:6px}.vehicle-monthly strong small{font-size:.75rem;color:#a1b5bc;font-weight:400}.vehicle-monthly p{font-size:.75rem;color:#8ba1a9;margin:5px 0 0}.vehicle-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:22px 0 0;padding:18px 0;border-top:1px solid #2b424b;border-bottom:1px solid #2b424b}.vehicle-summary strong{display:block;margin-top:6px;font-size:1rem;overflow-wrap:anywhere}.vehicle-details summary{cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:17px 0;color:#c9dddd;font-size:.9rem;font-weight:650;list-style:none}.vehicle-details summary::-webkit-details-marker{display:none}.vehicle-details summary span{font-size:1.2rem}.vehicle-details[open] summary span{transform:rotate(180deg)}.vehicle-details summary:focus-visible{outline:3px solid #6af8cb;outline-offset:3px}.breakdown{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}.breakdown .row{font-size:.84rem;color:#aabdc3}.breakdown strong{color:#e8f6fa}.vehicle-note{font-size:.75rem;line-height:1.5;color:#9db1b9}.vehicle-actions{display:flex;gap:10px;flex-wrap:wrap}.vehicle-actions button{font-size:.82rem;padding:10px 14px}@media(max-width:700px){.vehicle-top{grid-template-columns:1fr;gap:18px}.vehicle-media{max-height:none}.vehicle-overview{align-items:flex-start;flex-wrap:wrap;gap:18px}.vehicle-overview h2{margin-bottom:10px}.vehicle-monthly{border-left:0;padding-left:0}.vehicle-summary{gap:14px}.breakdown{grid-template-columns:1fr}}@media(max-width:400px){.vehicle-summary{grid-template-columns:1fr}}
.step .grid>label{display:flex;flex-direction:column;align-self:end;min-width:0}.step .grid>label>input,.step .grid>label>select{flex:none}
.registration-breakdown{margin-top:18px;padding:15px;border:1px solid #29454d;border-radius:12px;background:#0c1a20;font-size:.83rem}.registration-breakdown[hidden]{display:none}.registration-breakdown strong{display:block;margin-bottom:8px;color:#e8f6fa}.registration-breakdown div{display:flex;justify-content:space-between;gap:12px;padding:4px 0;color:#b8cbd0}.registration-breakdown small{display:block;margin-top:10px;line-height:1.5}

.finance-empty{padding:20px;margin:14px 0;border:1px dashed #35505b;border-radius:12px;color:#e8f6fa}.finance-empty[hidden]{display:none}.finance-empty p{color:#9db1b9;font-size:.88rem;margin:7px 0 0}.finance-offer{border:1px solid #35505b;border-radius:12px;background:#0c1a20;padding:16px;margin:14px 0}.finance-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.finance-radio{display:flex;align-items:center;gap:8px;margin:0;color:#b8d4d3}.finance-radio input{width:auto;margin:0}.finance-preview{margin:12px 0 0;color:#6af8cb;font-size:.85rem}.finance-comparison{padding:18px 0;border-bottom:1px solid #2b424b}.finance-comparison-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:12px}.finance-comparison-head h3{font-size:.95rem}.finance-list{display:grid;gap:8px}.finance-option{width:100%;text-align:left;display:flex;justify-content:space-between;align-items:center;gap:12px;background:#13262e;color:#e8f6fa;border:1px solid #304750;font-weight:400}.finance-option.selected{border-color:#6af8cb;background:#173a37}.finance-option span{min-width:0}.finance-option span:last-child{text-align:right}.finance-option strong,.finance-option small{display:block}.finance-option strong{font-size:.88rem;overflow-wrap:anywhere}.finance-option small{font-size:.73rem;line-height:1.4;margin-top:4px;color:#a9bdc4}@media(max-width:500px){.finance-option{align-items:flex-start;flex-direction:column}.finance-option span:last-child{text-align:left}}

dialog#modal{padding:0;overflow:hidden;max-height:min(90dvh,900px);width:min(820px,calc(100% - 32px));border:1px solid #29434d}#form{display:flex;flex-direction:column;max-height:min(90dvh,900px);min-height:0}.modal-header{flex:none;padding:22px 24px 0;background:#101d25}.modal-header .step-header{margin-bottom:16px}.modal-header .steps{margin:0 0 20px}.modal-content{padding:0 24px 24px;overflow-y:auto;overscroll-behavior:contain;min-height:0;scrollbar-width:thin;scrollbar-color:#43646b transparent}.modal-content::-webkit-scrollbar{width:8px}.modal-content::-webkit-scrollbar-track{background:transparent}.modal-content::-webkit-scrollbar-thumb{background:#43646b;border:2px solid #101d25;border-radius:8px}.wizard-actions{flex:none;margin:0;padding:16px 24px;border-top:1px solid #29434d;background:#101d25;box-shadow:0 -8px 22px #07111655}.wizard-actions>div{margin-left:auto}@media(max-width:540px){dialog#modal{width:calc(100% - 20px);max-height:calc(100dvh - 20px)}#form{max-height:calc(100dvh - 20px)}.modal-header{padding:18px 18px 0}.modal-content{padding:0 18px 18px}.wizard-actions{padding:12px 18px;gap:8px}.wizard-actions button{padding:10px 12px}.wizard-actions>div{gap:6px}}

.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.steps button{min-width:0;display:flex;align-items:center;justify-content:center;gap:7px;background:#172a32;color:#a0b6bc;border:1px solid #29424a;border-bottom:3px solid #29424a;border-radius:9px;padding:10px 6px;font-size:.77rem;font-weight:650;transition:background .2s,border-color .2s,color .2s}.steps button svg{width:17px;height:17px;flex:none;stroke-width:1.8}.steps button span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.steps button.current{background:#193b38;border-color:#3d7f72;border-bottom-color:#6af8cb;color:#8fffe0}.steps button.completed{border-bottom-color:#559c8a;color:#c3ddd8}.steps button:hover:not(:disabled){background:#20403e}.steps button:focus-visible{outline:3px solid #6af8cb;outline-offset:2px}@media(max-width:540px){.steps{gap:4px}.steps button{flex-direction:column;gap:4px;padding:7px 2px;font-size:.64rem}.steps button svg{width:16px;height:16px}}

.finance-head{align-items:center}.finance-radio{position:relative;cursor:pointer;display:inline-flex}.finance-radio input{position:absolute;opacity:0;width:1px;height:1px;overflow:hidden}.finance-radio-button{display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:8px 12px;border:1px solid #456269;border-radius:9px;color:#bed1d3;background:#172d34;font-size:.8rem;font-weight:650;transition:background .2s,border-color .2s,color .2s}.finance-radio-icon{display:grid;place-items:center;width:18px;height:18px;border:1px solid #719096;border-radius:50%;font-size:12px;color:transparent}.finance-radio input:checked+.finance-radio-button{background:#193d35;border-color:#55bca2;color:#a5ffe2}.finance-radio input:checked+.finance-radio-button .finance-radio-icon{background:#6af8cb;border-color:#6af8cb;color:#0a2921}.finance-radio input:focus-visible+.finance-radio-button{outline:3px solid #6af8cb;outline-offset:3px}.finance-offer.finance-selected{border-color:#468f7d}.finance-radio:hover .finance-radio-button{border-color:#6af8cb}@media(max-width:420px){.finance-head{align-items:flex-start}.finance-radio-button{font-size:.72rem;padding:7px 8px}.finance-head .finance-remove{padding:9px}}

.insurance-comparison{margin:0;padding:18px 0;border-bottom:1px solid #2b424b}.insurance-comparison-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.insurance-comparison-head h3{font-size:.95rem;margin:0 0 4px}.insurance-comparison-head small{color:#a9bdc4;font-size:.75rem;font-weight:400}.insurance-comparison-head>strong{white-space:nowrap;font-size:1rem}.insurance-options{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:8px}.insurance-option{display:flex;align-items:center;gap:10px;min-width:0;text-align:left;background:#13262e;color:#e8f6fa;border:1px solid #304750;font-weight:400}.insurance-option.selected{border-color:#6af8cb;background:#173a37}.insurance-indicator{display:grid;place-items:center;width:25px;height:25px;flex:none;border:1px solid #6b8d91;border-radius:8px;color:#a6c7c3;font-weight:700}.insurance-option.selected .insurance-indicator{background:#6af8cb;border-color:#6af8cb;color:#0b2820}.insurance-info{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1}.insurance-info strong{font-size:.85rem;overflow-wrap:anywhere}.insurance-info small{color:#a9bdc4;line-height:1.35;overflow-wrap:anywhere}.insurance-state{font-size:.7rem;color:#9ec4bd}.insurance-cost{white-space:nowrap;font-size:.85rem}.insurance-cost small{font-weight:400;color:#a9bdc4}.insurance-empty{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px dashed #35505b;border-radius:10px;padding:12px;color:#a9bdc4;font-size:.85rem}.insurance-empty button{font-size:.8rem;white-space:nowrap}.insurance-option:focus-visible{outline:3px solid #6af8cb;outline-offset:2px}@media(max-width:480px){.insurance-comparison-head{align-items:flex-start}.insurance-empty{align-items:flex-start;flex-direction:column}.insurance-option{padding:10px}.insurance-cost{font-size:.75rem}}

.monthly-link{padding:0;background:transparent;color:#6af8cb;text-align:left;border-radius:5px}.monthly-link:hover:not(:disabled){transform:none;filter:brightness(1.12)}.monthly-link span{display:block;color:#a9ddd0;font-size:.72rem;font-weight:500;margin-top:3px;text-decoration:underline;text-underline-offset:3px}.overview-link strong{margin-top:6px}.monthly-link:focus-visible{outline:3px solid #6af8cb;outline-offset:2px}dialog#monthlyDialog{width:min(520px,calc(100% - 32px));max-height:85dvh;overflow:auto;background:#101d25;border:1px solid #35505b;border-radius:18px;padding:24px;color:#e8f6fa}#monthlyDialog::backdrop{background:#000b}.monthly-dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.monthly-dialog-head h2{margin:6px 0;font-size:1.4rem}.monthly-dialog-head p{margin:0 0 18px}.monthly-row{display:flex;justify-content:space-between;gap:16px;padding:13px 0;border-bottom:1px solid #29404a;font-size:.9rem}.monthly-row strong{font-weight:650}.monthly-row>strong{white-space:nowrap}.monthly-row small{display:block;color:#9db1b9;margin-top:4px}.monthly-total{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:20px 0 12px;font-weight:700}.monthly-total strong{font-size:1.4rem;color:#6af8cb}.monthly-note{font-size:.78rem;color:#9db1b9;line-height:1.5}.monthly-dialog-footer{display:flex;justify-content:flex-end;margin-top:18px}

dialog#monthlyDialog{padding:0;overflow:hidden;max-height:85dvh}dialog#monthlyDialog[open]{display:flex;flex-direction:column}.monthly-dialog-head{flex:none;padding:22px 24px 0}.monthly-dialog-head p{margin-bottom:16px}.monthly-content{min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:0 24px;scrollbar-width:thin;scrollbar-color:#43646b transparent}.monthly-content::-webkit-scrollbar{width:8px}.monthly-content::-webkit-scrollbar-thumb{background:#43646b;border:2px solid #101d25;border-radius:8px}.monthly-dialog-footer{flex:none;margin:0;padding:14px 24px;border-top:1px solid #29434d;background:#101d25}

.vehicle-summary{grid-template-columns:repeat(3,minmax(0,1fr));align-items:start;gap:20px}.vehicle-summary .summary-total{text-align:right}.vehicle-summary .summary-total strong{color:#6af8cb;font-size:1.08rem}@media(max-width:700px){.vehicle-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.vehicle-summary .summary-total{grid-column:1 / -1;text-align:left;padding-top:12px;border-top:1px solid #2b424b}}@media(max-width:400px){.vehicle-summary{grid-template-columns:1fr}.vehicle-summary .summary-total{grid-column:auto}}

header{position:relative}.header-actions{display:flex;gap:8px;align-items:center}.header-menu{display:flex;gap:8px;align-items:center}.header-menu form{margin:0}.header-menu .button,.header-menu button{display:flex;align-items:center;gap:8px}.header-menu svg{width:16px;height:16px;flex:none}.menu-toggle{display:none;width:44px;height:44px;padding:0;place-items:center}.menu-toggle svg{width:20px;height:20px}.menu-toggle .icon-open,.menu-toggle[aria-expanded=true] .icon-closed{display:none}.menu-toggle[aria-expanded=true] .icon-open{display:block}@keyframes menu-in{from{opacity:0;transform:translateY(-6px)}}
@media(max-width:640px){header,main{padding-left:16px;padding-right:16px}header{padding-top:14px;padding-bottom:14px}.header-actions .wide-label{display:none}#add{width:44px;height:44px;padding:0;font-size:1.4rem;line-height:1}.menu-toggle{display:grid}.header-menu{display:none;position:absolute;z-index:20;top:calc(100% + 6px);right:16px;min-width:200px;flex-direction:column;align-items:stretch;gap:6px;padding:8px;background:#101d25;border:1px solid #27404a;border-radius:14px;box-shadow:0 16px 40px #000a}.header-menu.open{display:flex;animation:menu-in .16s ease-out}.header-menu .button,.header-menu button{width:100%;text-align:left;padding:12px 14px}}
.pointer-coarse{display:none}@media(pointer:coarse){.pointer-fine{display:none}.pointer-coarse{display:block}}
@media(max-width:540px){.vehicle-card{padding:16px}form .grid{gap:0 18px}#uploader.dropzone{min-height:150px}.wizard-actions .wide-label{display:none}#back,#next{min-width:44px;font-size:1.05rem;padding:8px 12px}}
@media(max-width:480px){.insurance-option{display:grid;grid-template-columns:25px minmax(0,1fr);align-items:start}.insurance-cost{grid-column:2}}
</style></head><body><header><strong>⚡ VOLT <span class="accent">/</span> COMPARADOR</strong><div class="header-actions"><button id="add" aria-label="Agregar vehículo">+<span class="wide-label"> Agregar vehículo</span></button><button type="button" class="secondary menu-toggle" id="menuToggle" aria-label="Menú" aria-expanded="false" aria-controls="headerMenu"><i data-lucide="menu" class="icon-closed" aria-hidden="true"></i><i data-lucide="x" class="icon-open" aria-hidden="true"></i></button><nav class="header-menu" id="headerMenu" aria-label="Cuenta"><a href="/perfil" class="button secondary"><i data-lucide="user-round" aria-hidden="true"></i>Perfil</a><form method="post" action="/logout"><button type="submit" class="secondary"><i data-lucide="log-out" aria-hidden="true"></i>Salir</button></form></nav></div></header><main><p class="accent">TU PRÓXIMO ELÉCTRICO, EN NÚMEROS</p><h1>Compara con <span class="accent">claridad.</span></h1><p class="muted">Precio, financiación y costos asociados en un solo lugar.</p><section><div id="cards" class="grid"></div><div id="empty" class="empty"><div class="empty-icon" aria-hidden="true">⚡</div><h2>Empieza tu comparación</h2><p>Agrega tu primer vehículo y reúne aquí sus precios, fotos y costos.</p><button type="button" id="add-first">+ Agregar mi primer vehículo</button></div></section></main><dialog id="modal"><form id="form" novalidate><div class="modal-header"><div class="step-header"><div><small class="accent" id="step-count"></small><h2 id="wizard-title">Agregar vehículo</h2></div><button type="button" class="secondary" id="cancel" aria-label="Cerrar">✕</button></div><nav class="steps" aria-label="Pasos del vehículo"><button type="button" data-step="0"><i data-lucide="car-front" aria-hidden="true"></i><span>Vehículo</span></button><button type="button" data-step="1"><i data-lucide="file-text" aria-hidden="true"></i><span>Documentos</span></button><button type="button" data-step="2"><i data-lucide="landmark" aria-hidden="true"></i><span>Financiación</span></button><button type="button" data-step="3"><i data-lucide="shield-check" aria-hidden="true"></i><span>Seguros</span></button></nav></div><input type="hidden" name="id"/><div class="modal-content" id="modalContent">
<div class="step"><h3 class="step-title">Tu vehículo</h3><p class="muted">Agrega lo esencial y elige la foto que aparecerá en el listado.</p><div class="grid"><label>Nombre y versión<input name="name" required placeholder="Ej. GWM Ora 5 Full"/></label><label>Precio (COP)<input name="price" class="money" type="text" inputmode="numeric" value="0"/></label></div><div class="media-section"><h3 class="step-title">Fotos y videos</h3><p class="muted">Arrastra tus archivos o selecciónalos para subirlos. Se optimizan al terminar la carga.</p><div id="uploader" class="dropzone" tabindex="0" role="button" aria-label="Seleccionar fotos y videos"><div class="dz-message"><span class="upload-icon" aria-hidden="true">↑</span><strong class="pointer-fine">Arrastra fotos y videos aquí</strong><span class="pointer-fine">o haz clic en cualquier parte para elegir archivos</span><strong class="pointer-coarse">Toca para elegir fotos y videos</strong></div></div><div id="upload-previews" class="dropzone-previews"></div><p id="status" role="status" class="muted"></p><div id="saved-section" hidden><h3>Archivos guardados</h3><div id="files" class="gallery"></div></div></div></div>
<div class="step" hidden><h3 class="step-title">Costo de documentos</h3><p class="muted">Selecciona una tarifa de referencia o introduce una cotización.</p><div class="grid"><label class="document-select">Matrícula · Barranquilla<select name="registrationOption" id="registrationOption"><option value="none">Sin definir</option><option value="electric">Eléctrico o híbrido particular · $ 356.798</option><option value="electricLien">Eléctrico o híbrido con gravamen · $ 434.009</option><option value="standard">Particular · $ 398.798</option><option value="standardLien">Particular con gravamen · $ 518.009</option><option value="custom">Otro valor / cotización</option></select><span class="selected-option" id="registrationChoice" aria-live="polite"></span></label><label>Valor de matrícula (COP)<input name="registration" class="money" type="text" inputmode="numeric" value="0"/></label><label>Beneficio o descuento adicional<input name="benefitName" placeholder="Ej. descuento del concesionario"/></label><label>Porcentaje de descuento adicional (%)<input name="benefitPercent" type="number" min="0" max="100" step="0.01" value="0"/></label><label class="document-select">SOAT · categoría de referencia<select name="soatOption" id="soatOption"><option value="none">Sin definir</option><option value="511">Auto familiar, menor a 1.500 cc, 0–9 años · $ 447.300</option><option value="512">Auto familiar, menor a 1.500 cc, 10 años o más · $ 592.900</option><option value="211">Campero o camioneta, menor a 1.500 cc, 0–9 años · $ 792.800</option><option value="212">Campero o camioneta, menor a 1.500 cc, 10 años o más · $ 953.000</option><option value="custom">Otra tarifa / cotización</option></select><span class="selected-option" id="soatChoice" aria-live="polite"></span></label><label>SOAT anual antes del beneficio (COP)<input name="soat" class="money" type="text" inputmode="numeric" value="0"/></label><label>Beneficio sobre el SOAT (%)<input name="soatDiscount" id="soatDiscount" type="number" min="0" max="100" step="0.01" value="0"/></label><div class="document-select"><p class="muted" id="soatTotal" aria-live="polite"></p><small>El porcentaje se aplica al total ingresado como una estimación. Confirma con la aseguradora si tu beneficio aplica al total o solo a una parte.</small></div><label class="document-select">Impuesto vehicular · Atlántico<select name="taxMode" id="taxMode"><option value="electric">Estimar para vehículo 100 % eléctrico</option><option value="manual">Ingresar liquidación oficial</option></select></label><div class="document-select tax-estimate" id="taxEstimate" hidden><div class="grid"><label>Avalúo comercial (COP)<input name="appraisal" class="money" type="text" inputmode="numeric" value="0"/></label><label>Tarifa sobre avalúo (%)<input name="taxRate" id="taxRate" type="number" min="0" max="1" step="0.01" value="1"/></label><label>Descuento departamental<select name="taxDiscount" id="taxDiscount"><option value="0">Sin descuento</option><option value="70">70 % · nuevo elegible, 5 vigencias siguientes</option></select></label></div><small>El avalúo se inicia con el precio solo como referencia; sustitúyelo por el avalúo fiscal oficial, que puede ser diferente. El 70 % corresponde a los cinco años siguientes al de matrícula para vehículos nuevos elegibles; no se aplica automáticamente al año de matrícula. Confirma la liquidación con la Gobernación. <a href="https://atlantico.gov.co/images/stories/gacetas/2024/DECRETO_ORDENANZAL_487_DE_2024_PARTE_1.pdf" target="_blank" rel="noopener">Ver norma departamental</a>.</small></div><label>Impuesto vehicular anual estimado (COP)<input name="tax" class="money" type="text" inputmode="numeric" value="0"/></label><label class="document-select">Derecho de tránsito anual · Barranquilla<select name="transitOption" id="transitOption"><option value="none">Sin definir</option><option value="electric">Eléctrico / híbrido · $ 149.500</option><option value="standard">Particular convencional · $ 299.000</option><option value="custom">Otro valor / liquidación</option></select></label><label>Valor de tránsito anual (COP)<input name="transit" class="money" type="text" inputmode="numeric" value="0"/></label><label>Beneficio en derecho de tránsito<select name="transitDiscount" id="transitDiscount"><option value="0">Sin descuento</option><option value="10">10 % por pronto pago 2026 (si es elegible)</option></select></label><div class="document-select"><small>El 10 % por pronto pago de 2026 estuvo sujeto a fecha y requisitos; no se aplica automáticamente. <a href="https://barranquilla.gov.co/transito/vehiculos-con-placa-de-barranquilla-10-de-descuento-en-derecho-de-transito-2026-hasta-el-31-de-mayo" target="_blank" rel="noopener">Condiciones y plazo 2026</a>.</small><p class="muted" id="transitTotal"></p></div></div><div class="registration-breakdown" id="registrationBreakdown" hidden></div><p class="muted" id="registrationTotal"></p><small>Tarifas oficiales de Barranquilla 2026, incluidos los valores especiales para eléctricos e híbridos. Aplica el descuento adicional solo si corresponde a la matrícula. <a href="https://barranquilla.gov.co/wp-content/uploads/2026/01/tarifas-2026-v7-ort-1.pdf" target="_blank" rel="noopener">Ver tarifas oficiales</a>. Los beneficios del derecho de tránsito anual son independientes de la matrícula.</small><p><small>SOAT: valores máximos 2026 con aportes y RUNT. Para eléctricos se usa el menor cilindraje de la categoría correspondiente; verifica la clase en la tarjeta de propiedad y la cotización. <a href="https://www.fasecolda.com/wp-content/uploads/Tarifas-SOAT-2026-referencia.pdf" target="_blank" rel="noopener">Tabla de Fasecolda</a>.</small></p></div>
<div class="step" hidden><h3 class="step-title">Ofertas de financiación</h3><p class="muted">Las ofertas se comparten entre todos tus vehículos: agrégalas una sola vez y elige cuál usar en este. Si editas o eliminas una, el cambio aplica a todos.</p><div id="finance-offers"></div><div id="finance-empty" class="finance-empty"><strong>Compara tus opciones</strong><p>Agrega la primera oferta para calcular su cuota y compararla con otras.</p></div><button type="button" class="secondary" id="addFinance">+ Agregar primera oferta</button></div>
<div class="step" hidden><h3 class="step-title">Seguros</h3><p class="muted">Agrega los seguros y activa los que quieras incluir en el cálculo.</p><div id="insurances"></div><button type="button" class="secondary" id="addInsurance">+ Agregar primer seguro</button></div>
</div><div class="wizard-actions"><button type="button" class="secondary" id="back" aria-label="Atrás">←<span class="wide-label"> Atrás</span></button><div><button type="submit" id="save">Crear vehículo</button><button type="button" id="next" class="secondary"><span class="wide-label">Documentos </span>→</button></div></div></form></dialog><dialog id="monthlyDialog" aria-labelledby="monthlyTitle"><div class="monthly-dialog-head"><div><small class="accent">COSTO MENSUAL</small><h2 id="monthlyTitle">Desglose mensual</h2><p class="muted" id="monthlySubtitle"></p></div><button class="secondary" id="monthlyClose" type="button" aria-label="Cerrar desglose">✕</button></div><div class="monthly-content"><div id="monthlyRows"></div><div class="monthly-total"><span>Total mensual estimado</span><strong id="monthlyTotal"></strong></div><p class="monthly-note">SOAT, impuesto y tránsito se dividen entre 12 para estimar su costo mensual; no son pagos mensuales al banco.</p></div><div class="monthly-dialog-footer"><button type="button" id="monthlyDone">Entendido</button></div></dialog><script>
import Dropzone from "dropzone";
import { createIcons, CarFront, FileText, Landmark, ShieldCheck, Menu, X, UserRound, LogOut } from "lucide";
createIcons({icons:{CarFront,FileText,Landmark,ShieldCheck,Menu,X,UserRound,LogOut}});
const menuToggle=document.getElementById('menuToggle'),headerMenu=document.getElementById('headerMenu');
const isMenuOpen=()=>menuToggle.getAttribute('aria-expanded')==='true';
const setMenu=open=>{menuToggle.setAttribute('aria-expanded',String(open));headerMenu.classList.toggle('open',open)};
menuToggle.addEventListener('click',()=>setMenu(!isMenuOpen()));
document.addEventListener('click',e=>{if(isMenuOpen()&&!menuToggle.contains(e.target)&&!headerMenu.contains(e.target))setMenu(false)});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&isMenuOpen()){setMenu(false);menuToggle.focus()}});
import AutoNumeric from "autonumeric";
import { animate } from "motion";
import "dropzone/dist/dropzone.css";
const $=s=>document.querySelector(s), fmt=n=>new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(n||0),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let vehicles=[],media=[],savedMedia=[],step=0,uploading=false,primaryImage='';
const moneyOptions={digitGroupSeparator:'.',decimalCharacter:',',decimalPlaces:0,minimumValue:'0',maximumValue:'999999999999999',modifyValueOnWheel:false};
const moneyFields={};document.querySelectorAll('input.money').forEach(el=>moneyFields[el.name]=new AutoNumeric(el,moneyOptions));
function updateSelectedOptions(){for(const [selectId,textId] of [['registrationOption','registrationChoice'],['soatOption','soatChoice']]){const el=document.getElementById(selectId);document.getElementById(textId).textContent=el.value==='none'?'':el.selectedOptions[0].textContent}}
function updateSoat(){const amount=Number(moneyFields.soat.getNumber())||0;const discount=Math.min(100,Math.max(0,Number($('#soatDiscount').value)||0));$('#soatTotal').textContent='SOAT anual después del beneficio: '+fmt(amount*(1-discount/100))}
$('#soatDiscount').oninput=updateSoat;
const soatOptions={none:0,'511':447300,'512':592900,'211':792800,'212':953000};$('#soatOption').onchange=e=>{if(e.target.value!=='custom')moneyFields.soat.set(soatOptions[e.target.value]);updateSelectedOptions();syncTariffControls();updateSoat()};document.querySelector('[name=soat]').addEventListener('input',()=>{$('#soatOption').value='custom';updateSelectedOptions();updateSoat()});
const registrationOptions={none:0,electric:356798,electricLien:434009,standard:398798,standardLien:518009};
const transitOptions={none:0,electric:149500,standard:299000};
function syncTariffControls(){for(const [option,field] of [['registrationOption','registration'],['soatOption','soat'],['transitOption','transit']])document.querySelector(`[name=${field}]`).readOnly=$('#'+option).value!=='custom'}
function updateTax(){const estimate=$('#taxMode').value==='electric';$('#taxEstimate').hidden=!estimate;document.querySelector('[name=tax]').readOnly=estimate;if(estimate){const appraisal=Number(moneyFields.appraisal.getNumber())||0;const rate=Math.min(1,Math.max(0,Number($('#taxRate').value)||0));const discount=Math.min(100,Math.max(0,Number($('#taxDiscount').value)||0));moneyFields.tax.set(Math.round(appraisal*rate/100*(1-discount/100)))}}
function updateTransit(){const value=Number(moneyFields.transit.getNumber())||0, discount=Math.min(100,Math.max(0,Number($('#transitDiscount').value)||0));$('#transitTotal').textContent='Derecho de tránsito estimado: '+fmt(value*(1-discount/100))}
$('#taxMode').onchange=updateTax;$('#taxRate').oninput=updateTax;$('#taxDiscount').onchange=updateTax;document.querySelector('[name=appraisal]').addEventListener('input',updateTax);
$('#transitOption').onchange=e=>{if(e.target.value!=='custom')moneyFields.transit.set(transitOptions[e.target.value]);updateTransit();syncTariffControls()};document.querySelector('[name=transit]').addEventListener('input',()=>{$('#transitOption').value='custom';updateTransit()});$('#transitDiscount').onchange=updateTransit;
const registrationBreakdowns={electric:[213000,3200,50598,72000,18000],electricLien:[255000,4300,75909,72000,26800],standard:[213000,45200,50598,72000,18000],standardLien:[255000,88300,75909,72000,26800]};
function updateRegistration(){const breakdown=registrationBreakdowns[$('#registrationOption').value];const box=$('#registrationBreakdown');box.hidden=!breakdown;if(breakdown){const labels=['Derechos, placa y sistematización','Estampillas distritales','Estampillas departamentales','Ministerio de Transporte','RUNT'];box.innerHTML='<strong>Desglose de matrícula · tarifa oficial 2026</strong>'+breakdown.map((value,i)=>`<div><span>${labels[i]}</span><span>${fmt(value)}</span></div>`).join('')+'<small>Solo incluye este trámite. SOAT, impuesto vehicular, derecho de tránsito y otros cobros se calculan aparte.</small>'}const val=Number(moneyFields.registration.getNumber())||0;const disc=Math.min(100,Math.max(0,Number(document.querySelector('[name=benefitPercent]').value)||0));$('#registrationTotal').textContent='Matrícula estimada después del descuento: '+fmt(val*(1-disc/100));}
$('#registrationOption').onchange=e=>{if(e.target.value!=='custom')moneyFields.registration.set(registrationOptions[e.target.value]);updateRegistration();updateSelectedOptions();syncTariffControls()};document.querySelector('[name=registration]').addEventListener('input',()=>{document.querySelector('[name=registrationOption]').value='custom';updateRegistration();updateSelectedOptions()});document.querySelector('[name=benefitPercent]').addEventListener('input',updateRegistration);
const dropzone=new Dropzone('#uploader',{url:'/api/upload',paramName:'file',clickable:true,previewsContainer:'#upload-previews',acceptedFiles:'image/*,video/*',maxFilesize:Infinity,parallelUploads:1,timeout:0,addRemoveLinks:false,dictRemoveFile:'Quitar',dictCancelUpload:'Cancelar carga',dictCancelUploadConfirmation:'¿Cancelar la carga?',dictInvalidFileType:'Solo se admiten imágenes y videos.',dictFileTooBig:'El archivo es demasiado grande.',dictResponseError:'No se pudo subir el archivo ({{statusCode}}).',previewTemplate:`<div class="upload-card"><div class="upload-thumb"><img data-dz-thumbnail alt=""><span class="upload-file-icon" aria-hidden="true">▶</span></div><div class="upload-detail"><strong class="upload-name" data-dz-name></strong><span class="upload-size" data-dz-size></span><span class="upload-state">En espera</span><button class="primary-choice" type="button" data-primary hidden>Elegir como principal</button><div class="upload-progress"><span data-dz-uploadprogress></span></div><span class="upload-error" data-dz-errormessage></span></div><button class="upload-remove" type="button" data-dz-remove aria-label="Quitar archivo">✕</button></div>`});
let resetting=false;
function refreshUploadState(){uploading=dropzone.getUploadingFiles().length>0||dropzone.getQueuedFiles().length>0;$('#save').disabled=uploading;}
dropzone.on('addedfile',()=>{refreshUploadState();$('#status').textContent='Preparando archivos…'});
dropzone.on('processing',file=>{file.previewElement.querySelector('.upload-state').textContent='Subiendo…';refreshUploadState();$('#status').textContent='Subiendo archivos…'});
dropzone.on('uploadprogress',(file,progress)=>{if(progress>=100){file.previewElement.querySelector('.upload-state').textContent='Optimizando…';$('#status').textContent='Carga completa. Optimizando el archivo; esto puede tardar…'}});
dropzone.on('success',(file,response)=>{file.savedMedia=response;media.push(response);if(response.type==='image'){const choice=file.previewElement.querySelector('[data-primary]');choice.hidden=false;choice.onclick=()=>{primaryImage=response.url;updatePrimary()};if(!primaryImage)primaryImage=response.url}updatePrimary();file.previewElement.querySelector('.upload-state').textContent='Listo';$('#status').textContent='Archivo procesado y listo.'});
dropzone.on('error',(file,message)=>{file.previewElement.querySelector('.upload-state').textContent='Error';$('#status').textContent=typeof message==='string'?message:'No se pudo subir el archivo.';refreshUploadState()});
dropzone.on('removedfile',file=>{if(!resetting&&file.savedMedia){media=media.filter(m=>m.url!==file.savedMedia.url);if(primaryImage===file.savedMedia.url)primaryImage=media.find(m=>m.type==='image')?.url||'';showFiles();updatePrimary()}refreshUploadState()});
dropzone.on('queuecomplete',()=>{refreshUploadState()});
$('#uploader').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();$('#uploader').click()}});

function setStep(n){step=n;$('#modalContent').scrollTop=0;document.querySelectorAll('.step').forEach((el,i)=>el.hidden=i!==n);document.querySelectorAll('.steps [data-step]').forEach((el,i)=>{el.classList.toggle('current',i===n);el.classList.toggle('completed',i<n);if(i===n)el.setAttribute('aria-current','step');else el.removeAttribute('aria-current')});$('#step-count').textContent=`PASO ${n+1} DE 4`;$('#back').hidden=n===0;$('#next').hidden=n===3;const nextName=['Documentos','Financiación','Seguros',''][n];$('#next').querySelector('.wide-label').textContent=nextName+' ';$('#next').setAttribute('aria-label','Siguiente: '+nextName);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)animate(document.querySelectorAll('.step')[n],{opacity:[0,1],transform:['translateY(10px)','translateY(0px)']},{duration:.25});}
document.querySelectorAll('.steps [data-step]').forEach(btn=>btn.addEventListener('click',()=>setStep(Number(btn.dataset.step))));
$('#back').onclick=()=>setStep(step-1);$('#next').onclick=()=>{const current=document.querySelectorAll('.step')[step];for(const input of current.querySelectorAll('input'))if(!input.reportValidity())return;if(step===0 && !Number(moneyFields.appraisal.getNumber()) && $('#taxMode').value==='electric'){moneyFields.appraisal.set(moneyFields.price.getNumber());updateTax()}setStep(step+1)};
function updatePrimary(){dropzone.files.forEach(file=>{if(file.savedMedia?.type==='image'){let btn=file.previewElement.querySelector('[data-primary]');btn.textContent=primaryImage===file.savedMedia.url?'★ Foto principal':'☆ Elegir como principal';btn.classList.toggle('selected',primaryImage===file.savedMedia.url)}});document.querySelectorAll('[data-saved-primary]').forEach(btn=>{const active=btn.dataset.savedPrimary===primaryImage;btn.textContent=active?'★ Foto principal':'☆ Hacer principal';btn.classList.toggle('selected',active)})}
function updateInsuranceAction(){$('#addInsurance').textContent=$('#insurances').children.length?'+ Agregar otro seguro':'+ Agregar primer seguro'}
function insurance(x={}){let d=document.createElement('div');d.className='insurance';d.innerHTML=`<label><input type="checkbox" class="active" ${x.active?'checked':''}> Incluir seguro</label><div class="grid"><label>Nombre<input class="iname" value="${esc(x.name||'')}"></label><label>Descripción<input class="desc" value="${esc(x.description||'')}"></label><label>Precio mensual<input class="cost" type="text" inputmode="numeric" value="${Number(x.cost)||0}"></label></div><button class="danger remove" type="button">Eliminar seguro</button>`;d.querySelector('.remove').onclick=()=>{d.remove();updateInsuranceAction()};$('#insurances').append(d);updateInsuranceAction();new AutoNumeric(d.querySelector('.cost'),moneyOptions)}
function showFiles(){ $('#saved-section').hidden=!savedMedia.length; $('#files').innerHTML=savedMedia.map((m,i)=>`<div>${m.type==='video'?`<video src="${esc(m.url)}" controls></video>`:`<img src="${esc(m.url)}" alt="Foto">`}${m.type==='image'?`<button type="button" class="primary-choice" data-saved-primary="${esc(m.url)}">☆ Hacer principal</button>`:''}<button type="button" class="danger" data-remove="${i}">Quitar</button></div>`).join('');$('#files').querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{const removed=savedMedia.splice(+b.dataset.remove,1)[0];media=media.filter(m=>m.url!==removed.url);if(primaryImage===removed.url)primaryImage=media.find(m=>m.type==='image')?.url||'';showFiles();updatePrimary()});$('#files').querySelectorAll('[data-saved-primary]').forEach(b=>b.onclick=()=>{primaryImage=b.dataset.savedPrimary;updatePrimary()});updatePrimary() }
let financeOffers=[];
// Oferta que usa un vehículo: la que eligió o, si no eligió ninguna (o ya no existe), la primera.
function selectedOffer(v){return financeOffers.find(x=>x.id===v.selectedFinanceId)||financeOffers[0]}
function updateFinanceSelection(){document.querySelectorAll('.finance-offer').forEach(offer=>{const active=offer.querySelector('input[type=radio]').checked;offer.classList.toggle('finance-selected',active);offer.querySelector('.finance-radio-label').textContent=active?'Usada en este vehículo':'Usar en este vehículo'})}
function updateFinanceAction(){updateFinanceSelection();const any=$('#finance-offers').children.length>0;$('#finance-empty').hidden=any;$('#addFinance').textContent=any?'+ Agregar otra oferta':'+ Agregar primera oferta'}
function financeTermOptions(value){const term=Number(value)||60;const terms=[12,24,36,48,60,72];if(term>0&&!terms.includes(term))terms.push(term);return terms.sort((a,b)=>a-b).map(months=>{const years=Math.floor(months/12),remaining=months%12;const label=[years?`${years} ${years===1?'año':'años'}`:'',remaining?`${remaining} ${remaining===1?'mes':'meses'}`:''].filter(Boolean).join(' y ');return `<option value="${months}" ${months===term?'selected':''}>${months} meses (${label})${months%12?' · plazo guardado':''}</option>`}).join('')}
function addFinance(x={},selected=false){const id=x.id||crypto.randomUUID();const d=document.createElement('div');d.className='finance-offer';d.dataset.id=id;d.innerHTML=`<div class="finance-head"><label class="finance-radio"><input type="radio" name="financeChoice" value="${esc(id)}" ${selected?'checked':''}><span class="finance-radio-button"><span class="finance-radio-icon" aria-hidden="true">✓</span><span class="finance-radio-label">Elegir para el resumen</span></span></label><button type="button" class="danger finance-remove">Eliminar</button></div><div class="grid"><label>Banco u oferta<input class="finance-name" required placeholder="Ej. Banco A" value="${esc(x.name||'')}"></label><label>Porcentaje financiado (%)<input class="finance-percent" type="number" required min="0" max="100" step="0.01" value="${Number(x.percent)||0}"></label><label>Tasa efectiva mensual (%)<input class="finance-rate" type="number" required min="0" step="0.01" value="${Number(x.rate)||0}"></label><label>Plazo<select class="finance-months" required>${financeTermOptions(x.months)}</select></label></div><p class="finance-preview"></p>`;d.querySelector('.finance-remove').onclick=()=>{const was=d.querySelector('input[type=radio]').checked;d.remove();if(was){const first=$('#finance-offers input[type=radio]');if(first)first.checked=true}updateFinanceAction()};d.addEventListener('input',()=>{updateFinancePreview(d);updateFinanceSelection()});$('#finance-offers').append(d);if(!$('#finance-offers input[type=radio]:checked'))d.querySelector('input[type=radio]').checked=true;updateFinancePreview(d);updateFinanceAction()}
function updateFinancePreview(d){const p=(moneyFields.price.getNumber()||0)*(Number(d.querySelector('.finance-percent').value)||0)/100,r=(Number(d.querySelector('.finance-rate').value)||0)/100,n=Number(d.querySelector('.finance-months').value)||1,q=r?p*r/(1-Math.pow(1+r,-n)):p/n;d.querySelector('.finance-preview').textContent=`Monto financiado: ${fmt(p)} · Cuota estimada: ${fmt(q)} / mes`}
function openForm(v={}){let f=$('#form');for(const input of f.querySelectorAll('input:not(.money)')){if(input.type==='checkbox')input.checked=input.defaultChecked;else input.value=input.defaultValue}for(const select of f.querySelectorAll('select'))select.selectedIndex=0;for(let k of ['id','name','benefitName','benefitPercent','registrationOption','soatOption','soatDiscount','taxMode','taxRate','taxDiscount','transitOption','transitDiscount'])if(v[k]!=null)f.elements[k].value=v[k];for(const key of ['price','registration','soat','tax','appraisal','transit'])moneyFields[key].set(v[key]??0);$('#soatOption').value=v.soatOption||((+v.soat||0)>0?'custom':'none');$('#registrationOption').value=v.registrationOption||((+v.registration||0)>0?'custom':'none');$('#transitOption').value=v.transitOption||((+v.transit||0)>0?'custom':'none');if(!v.id)$('#taxMode').value='electric';syncTariffControls();updateRegistration();updateSelectedOptions();updateTax();updateTransit();updateSoat();$('#save').textContent=v.id?'Guardar cambios':'Crear vehículo';$('#wizard-title').textContent=v.id?'Editar vehículo':'Agregar vehículo';$('#finance-offers').innerHTML='';const chosenOffer=selectedOffer(v);financeOffers.forEach(offer=>addFinance(offer,offer.id===chosenOffer?.id));updateFinanceAction();$('#insurances').innerHTML='';(v.insurances||[]).forEach(insurance);updateInsuranceAction();media=[...(v.media||[])];savedMedia=[...media];primaryImage=v.primaryImage||media.find(m=>m.type==='image')?.url||'';showFiles();$('#status').textContent='';resetting=true;dropzone.removeAllFiles(true);resetting=false;refreshUploadState();setStep(0);$('#modal').showModal()}
function calc(v,offer){const chosen=offer||selectedOffer(v)||{percent:0,rate:0,months:60};let price=+v.price||0,p=price*(+chosen.percent||0)/100,r=(+chosen.rate||0)/100,n=+chosen.months||60,q=r?p*r/(1-Math.pow(1+r,-n)):p/n,ins=(v.insurances||[]).filter(x=>x.active).reduce((a,x)=>a+(+x.cost||0),0),soat=(+v.soat||0)*(1-Math.min(100,Math.max(0,+v.soatDiscount||0))/100),transit=(+v.transit||0)*(1-Math.min(100,Math.max(0,+v.transitDiscount||0))/100),annual=(soat+(+v.tax||0)+transit)/12;return{p,q,ins,annual,soat,transit,chosen,n,monthly:q+ins+annual,initial:price-p+((+v.registration||0)*(1-Math.min(100,Math.max(0,+v.benefitPercent||0))/100)),total:price-p+((+v.registration||0)*(1-Math.min(100,Math.max(0,+v.benefitPercent||0))/100))+(q+ins+annual)*n}}
function showMonthlyBreakdown(v,offer){const c=calc(v,offer);const lines=[{label:'Cuota del crédito',value:c.q,detail:c.chosen.id?`${c.chosen.name} · ${c.n} meses`:'Sin financiación seleccionada'},{label:'SOAT',value:c.soat/12,detail:'Valor anual prorrateado'},{label:'Impuesto vehicular',value:(+v.tax||0)/12,detail:'Valor anual prorrateado'},{label:'Derecho de tránsito',value:c.transit/12,detail:'Valor anual prorrateado'},...(v.insurances||[]).filter(item=>item.active).map(item=>({label:item.name||'Seguro',value:+item.cost||0,detail:'Seguro mensual incluido'}))];const roundedSum=lines.reduce((sum,line)=>sum+Math.round(line.value),0);const adjustment=Math.round(c.monthly)-roundedSum;$('#monthlySubtitle').textContent=`${v.name}${c.chosen.id?' · '+c.chosen.name:''}`;$('#monthlyRows').innerHTML=lines.map(line=>`<div class="monthly-row"><div><strong>${esc(line.label)}</strong><small>${esc(line.detail)}</small></div><strong>${fmt(line.value)}</strong></div>`).join('')+(adjustment?`<div class="monthly-row rounding"><div><strong>Ajuste por redondeo</strong><small>Para que los valores mostrados sumen el total</small></div><strong>${adjustment>0?'+':''}${fmt(adjustment)}</strong></div>`:'');$('#monthlyTotal').textContent=fmt(c.monthly);$('#monthlyDialog').showModal()}
$('#monthlyClose').onclick=()=>$('#monthlyDialog').close();$('#monthlyDone').onclick=()=>$('#monthlyDialog').close();
function render(){
  $('#empty').hidden=!!vehicles.length;
  $('#cards').innerHTML=vehicles.map(v=>{
    const c=calc(v), m=(v.media||[]).find(x=>x.url===v.primaryImage)||(v.media||[]).find(x=>x.type==='image')||(v.media||[])[0];
    const offers=financeOffers;const image=m?(m.type==='video'?`<video class="vehicle-media" controls src="${esc(m.url)}"></video>`:`<img class="vehicle-media" src="${esc(m.url)}" alt="${esc(v.name)}">`):'<div class="vehicle-media vehicle-placeholder"><span aria-hidden="true">◇</span><small>Sin foto</small></div>';
    return `<article class="vehicle-card"><div class="vehicle-top"><div class="vehicle-visual">${image}</div><div class="vehicle-overview"><div><span class="eyebrow">VEHÍCULO</span><h2>${esc(v.name)}</h2><span class="vehicle-price-label">Precio del vehículo</span><div class="vehicle-price">${fmt(v.price)}</div></div><div class="vehicle-monthly"><span>Costo mensual estimado</span><button type="button" class="monthly-link overview-link" data-monthly-vehicle="${v.id}" data-monthly-offer="${esc(c.chosen.id||'')}"><strong>${fmt(c.monthly)}<small> / mes</small></strong><span>Ver desglose ↗</span></button></div></div></div><div class="vehicle-summary"><div><span>Pago inicial + matrícula</span><strong>${fmt(c.initial)}</strong></div><div><span>Mensualidades y gastos · ${c.n} meses</span><strong>${fmt(Math.round(c.total)-Math.round(c.initial))}</strong></div><div class="summary-total"><span>Total estimado al final</span><strong>${fmt(c.total)}</strong></div></div>${offers.length?`<div class="finance-comparison"><div class="finance-comparison-head"><h3>Ofertas de financiación</h3><small>Selecciona una oferta para actualizar el resumen</small></div><div class="finance-list">${offers.map(o=>{const oc=calc(v,o),active=o.id===c.chosen.id;return `<button type="button" class="finance-option ${active?'selected':''}" data-finance-vehicle="${v.id}" data-finance-id="${esc(o.id)}" aria-pressed="${active}"><span><strong>${esc(o.name)}</strong><small>${o.percent}% financiado · ${o.rate}% mensual · ${o.months} meses</small></span><span><strong>${fmt(oc.monthly)} / mes</strong><small>Inicial ${fmt(oc.initial)} · Total ${fmt(oc.total)}</small></span></button>`}).join('')}</div></div>`:''}<section class="insurance-comparison" aria-label="Seguros de ${esc(v.name)}"><div class="insurance-comparison-head"><div><h3>Seguros</h3><small>Activa los seguros que quieres incluir en la comparación.</small></div><strong>${fmt(c.ins)} <small>/ mes</small></strong></div>${(v.insurances||[]).length?`<div class="insurance-options">${v.insurances.map((insurance,index)=>`<button type="button" class="insurance-option ${insurance.active?'selected':''}" data-insurance-vehicle="${v.id}" data-insurance-index="${index}" aria-pressed="${!!insurance.active}"><span class="insurance-indicator" aria-hidden="true">${insurance.active?'✓':'+'}</span><span class="insurance-info"><strong>${esc(insurance.name||'Seguro sin nombre')}</strong>${insurance.description?`<small>${esc(insurance.description)}</small>`:''}<span class="insurance-state">${insurance.active?'Incluido en el cálculo':'Añadir al cálculo'}</span></span><strong class="insurance-cost">${fmt(+insurance.cost||0)} <small>/ mes</small></strong></button>`).join('')}</div>`:`<div class="insurance-empty"><span>Agrega una opción para comparar su costo.</span><button type="button" class="secondary" data-add-insurance="${v.id}">+ Agregar primer seguro</button></div>`}</section><details class="vehicle-details"><summary>Ver desglose de costos <span aria-hidden="true">⌄</span></summary><div class="breakdown"><div class="row"><span>Financiado (${+c.chosen.percent||0} %)</span><strong>${fmt(c.p)}</strong></div><div class="row"><span>Cuota mensual</span><strong>${fmt(c.q)}</strong></div><div class="row"><span>Seguros mensuales</span><strong>${fmt(c.ins)}</strong></div><div class="row"><span>SOAT / mes</span><strong>${fmt(c.soat/12)}</strong></div><div class="row"><span>Impuesto vehicular / mes</span><strong>${fmt((+v.tax||0)/12)}</strong></div><div class="row"><span>Derecho de tránsito / mes</span><strong>${fmt(c.transit/12)}</strong></div></div><p class="vehicle-note">Costos anuales prorrateados; el acumulado supone que las tarifas y descuentos ingresados se mantienen durante todo el plazo.</p></details><div class="vehicle-actions"><button class="secondary" data-edit="${v.id}">Editar y ver fotos</button><button class="danger" data-delete="${v.id}">Eliminar</button></div></article>`;
  }).join('');
  document.querySelectorAll('[data-monthly-vehicle]').forEach(button=>button.onclick=()=>{const v=vehicles.find(item=>item.id==button.dataset.monthlyVehicle);const offer=financeOffers.find(item=>item.id===button.dataset.monthlyOffer);showMonthlyBreakdown(v,offer)});
  document.querySelectorAll('[data-finance-vehicle]').forEach(b=>b.onclick=async()=>{const v=vehicles.find(x=>x.id==b.dataset.financeVehicle);v.selectedFinanceId=b.dataset.financeId;const r=await fetch('/api/vehicles',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(v)});if(r.ok)render();else alert('No se pudo guardar la selección')});
  document.querySelectorAll('[data-insurance-vehicle]').forEach(button=>button.onclick=async()=>{const v=vehicles.find(item=>item.id==button.dataset.insuranceVehicle);const index=Number(button.dataset.insuranceIndex);const updated={...v,insurances:v.insurances.map((item,i)=>i===index?{...item,active:!item.active}:item)};const controls=button.closest('.insurance-options').querySelectorAll('button');controls.forEach(el=>el.disabled=true);try{const response=await fetch('/api/vehicles',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(updated)});if(!response.ok)throw new Error();Object.assign(v,updated);render()}catch{controls.forEach(el=>el.disabled=false);alert('No se pudo actualizar el seguro. Inténtalo de nuevo.')}});
  document.querySelectorAll('[data-add-insurance]').forEach(button=>button.onclick=()=>{const v=vehicles.find(item=>item.id==button.dataset.addInsurance);openForm(v);setStep(3)});
  document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openForm(vehicles.find(v=>v.id==b.dataset.edit)));
  document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(confirm('¿Eliminar este vehículo?')){await fetch('/api/vehicles',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:+b.dataset.delete})});load()}})
}
async function load(){const [vehiclesResponse,offersResponse]=await Promise.all([fetch('/api/vehicles'),fetch('/api/finance-offers')]);vehicles=await vehiclesResponse.json();financeOffers=await offersResponse.json();render()}$('#add').onclick=()=>openForm();$('#add-first').onclick=()=>openForm();$('#cancel').onclick=()=>{if(uploading){$('#status').textContent='Espera a que termine la carga o cancélala desde el gestor.';return}$('#modal').close()};$('#modal').addEventListener('cancel',e=>{if(uploading){e.preventDefault();$('#status').textContent='Espera a que termine la carga o cancélala desde el gestor.'}});$('#addInsurance').onclick=()=>insurance();$('#addFinance').onclick=()=>addFinance();$('#form').onsubmit=async e=>{e.preventDefault();if(uploading)return;const pending=dropzone.files.some(file=>file.status!=='success');if(pending){$('#status').textContent='Sube o elimina los archivos pendientes antes de guardar.';return}let f=e.target;const invalidOffer=[...document.querySelectorAll('#finance-offers input:not([type=radio]), #finance-offers select')].find(x=>!x.checkValidity());if(invalidOffer){setStep(2);invalidOffer.reportValidity();return}for(const input of f.querySelectorAll('.step input, .step select')){if(!input.checkValidity()){const panel=input.closest('.step');setStep([...document.querySelectorAll('.step')].indexOf(panel));input.reportValidity();return}}let d=Object.fromEntries(new FormData(f));for(const key of ['price','registration','soat','tax','appraisal','transit'])d[key]=moneyFields[key].getNumericString()||'0';const offers=[...document.querySelectorAll('.finance-offer')].map(x=>({id:x.dataset.id,name:x.querySelector('.finance-name').value.trim(),percent:Number(x.querySelector('.finance-percent').value),rate:Number(x.querySelector('.finance-rate').value),months:Number(x.querySelector('.finance-months').value)}));d.selectedFinanceId=document.querySelector('#finance-offers input[type=radio]:checked')?.value||'';d.primaryImage=primaryImage;d.id=Number(d.id)||undefined;d.media=media;d.insurances=[...document.querySelectorAll('.insurance')].map(x=>({active:x.querySelector('.active').checked,name:x.querySelector('.iname').value,description:x.querySelector('.desc').value,cost:+AutoNumeric.getAutoNumericElement(x.querySelector('.cost')).getNumericString()}));const savedOffers=await fetch('/api/finance-offers',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(offers)});if(!savedOffers.ok)return alert(await savedOffers.text());let r=await fetch('/api/vehicles',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});if(!r.ok)return alert(await r.text());$('#modal').close();load()};load();
</script></body></html>
